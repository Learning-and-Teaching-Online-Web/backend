}

// ================================================================
// MODULE 7: REVIEW, FAVORITE & MATCHING (Đánh giá, Yêu thích & Gợi ý)
// ================================================================

// ================================================================
// BẢNG: reviews
// Mô tả: Lưu trữ bài đánh giá chất lượng gia sư từ học sinh sau khi học xong.
// Ràng buộc: booking_id @unique đảm bảo 1 đơn đặt lịch chỉ được viết 1 bài review (tránh spam).
// ================================================================
model Review {
  review_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho đánh giá
  booking_id      String   @unique @db.Uuid // Khóa ngoại 1-1 với bookings.booking_id (chống đánh giá trùng lập)
  student_id      String   @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id (người viết review)
  tutor_id        String   @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id (gia sư nhận review)
  rating          Int      @db.SmallInt // Điểm số đánh giá tổng thể (thang điểm 1 -> 5 sao)
  professionalism Int?     @db.SmallInt // Điểm tiêu chí: Trình độ chuyên môn & Phương pháp giảng dạy (1-5 sao)
  communication   Int?     @db.SmallInt // Điểm tiêu chí: Khả năng giao tiếp & Truyền đạt kiến thức (1-5 sao)
  punctuality     Int?     @db.SmallInt // Điểm tiêu chí: Sự đúng giờ & Tác phong làm việc (1-5 sao)
  comment         String? // Nội dung nhận xét bằng văn bản của học sinh
  is_visible      Boolean  @default(true) // Trạng thái hiển thị (true = công khai, false = tạm ẩn do vi phạm quy chuẩn)
  created_at      DateTime @default(now()) @db.Timestamptz // Thời điểm tạo đánh giá
  updated_at      DateTime @default(now()) @db.Timestamptz // Thời điểm chỉnh sửa đánh giá

  // Relations
  booking Booking        @relation(fields: [booking_id], references: [booking_id])
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@index([tutor_id, created_at(sort: Desc)], map: "idx_reviews_tutor")
  @@index([student_id], map: "idx_reviews_student")
  @@map("reviews")
}

// ================================================================
// BẢNG: favorites
// Mô tả: Danh sách gia sư yêu thích (Wishlist/Bookmark) của học sinh.
// Ràng buộc: @@unique([student_id, tutor_id]) đảm bảo học sinh không thể lưu 1 gia sư 2 lần.
// ================================================================
model Favorite {
  favorite_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho mục yêu thích
  student_id  String   @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id
  tutor_id    String   @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id
  created_at  DateTime @default(now()) @db.Timestamptz // Thời điểm bấm lưu gia sư yêu thích

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@unique([student_id, tutor_id])
  @@index([student_id], map: "idx_favorites_student")
  @@index([tutor_id], map: "idx_favorites_tutor")
  @@map("favorites")
}

// ================================================================
// BẢNG: matching_logs
// Mô tả: Nhật ký kết quả gợi ý Gia sư cho Học sinh do Thuật toán AI Matching thực hiện.
// Mục đích: Đánh giá độ chính xác của thuật toán AI (Machine Learning CTR/Conversion Rate).
// ================================================================
model MatchingLog {
  log_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bản ghi log AI
  student_id        String   @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id (người nhận gợi ý)
  tutor_id          String   @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id (gia sư được AI đề xuất)
  match_score       Decimal? @db.Decimal(5, 2) // Điểm độ phù hợp tính bằng % do AI tính (VD: 95.50%)
  algorithm_version String? // Phiên bản thuật toán AI Matching (VD: "v1.0-content-based", "v2.0-hybrid")
  factors_json      Json? // Mảng JSON lưu chi tiết trọng số lý do ghép cặp (VD: {"subject_match": 1.0, "budget_match": 0.85})
  is_clicked        Boolean   @default(false) // Cờ ghi nhận học sinh có bấm vào xem hồ sơ gia sư này không
  clicked_at        DateTime? @db.Timestamptz // Thời điểm học sinh bấm vào xem hồ sơ (null nếu chưa click)
  is_booked         Boolean   @default(false) // Cờ ghi nhận học sinh có thực hiện đặt lịch sau gợi ý không
  booked_at         DateTime? @db.Timestamptz // Thời điểm học sinh đặt lịch sau gợi ý (null nếu chưa book)
  created_at        DateTime  @default(now()) @db.Timestamptz // Thời điểm AI đưa ra gợi ý

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_matching_logs_student")
  @@index([tutor_id], map: "idx_matching_logs_tutor")
  @@map("matching_logs")
}

// ================================================================
// MODULE 8: DOCUMENT & AI (Tài liệu học tập & Trợ lý AI)
// ================================================================

// ================================================================
// BẢNG: documents
// Mô tả: Quản lý tài liệu học tập (PDF, DOCX, Slide...) do Gia sư upload lên cho khóa học.
// Mục đích: Làm dữ liệu đầu vào cho tính năng Trợ lý AI Hỏi đáp theo tài liệu (RAG - Retrieval-Augmented Generation).
// ================================================================
model Document {
  doc_id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho tài liệu
  course_id      String    @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa tài liệu)
  uploaded_by    String    @db.Uuid // Khóa ngoại liên kết tới users.user_id (người tải tài liệu lên)
  file_url       String // Đường dẫn lưu file đính kèm thực tế trên Cloud Storage
  file_type      String // Phân loại định dạng tệp tin ("pdf", "docx", "pptx", "txt"...)
  title          String // Tên tiêu đề của tài liệu (VD: "Giáo trình Giải tích 12 - Chương 1")
  description    String? // Tóm tắt ngắn gọn mô tả nội dung tài liệu
  extracted_text String? // Nội dung văn bản thô bóc tách từ file PDF/DOCX (dùng cho thuật toán RAG)
  is_indexed     Boolean   @default(false) // Trạng thái đã cắt chunk và vector hóa xong chưa (false = chưa, true = sẵn sàng RAG)
  indexed_at     DateTime? @db.Timestamptz // Thời điểm hoàn tất đánh chỉ mục vector
  metadata       Json?     @default("{}") // Mảng JSON chứa thông tin phụ (VD: {"page_count": 45, "author": "Nguyễn Văn A"})
  created_at     DateTime  @default(now()) @db.Timestamptz // Thời điểm upload tài liệu

  // Relations
  course Course          @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  user   User            @relation(fields: [uploaded_by], references: [user_id])
  chunks DocumentChunk[]

  @@index([course_id, created_at(sort: Desc)], map: "idx_documents_course")
  @@index([uploaded_by], map: "idx_documents_uploaded_by")
  @@map("documents")
}

// ================================================================
// BẢNG: document_chunks
// Mô tả: Lưu trữ các đoạn văn bản nhỏ (Chunks) được chia từ tài liệu gốc cùng vector nhúng (Embedding).
// Điểm nổi bật: Sử dụng kiểu dữ liệu Unsupported("vector(1536)") của pgvector (PostgreSQL) để thực hiện Similarity Search.
// ================================================================
model DocumentChunk {
  chunk_id    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho đoạn chunk
  doc_id      String                       @db.Uuid // Khóa ngoại liên kết tới documents.doc_id (Xóa tài liệu gốc -> xóa các chunk)
  content     String // Nội dung văn bản của đoạn chunk đã được cắt nhỏ
  chunk_index Int // Thứ tự của đoạn chunk trong tài liệu gốc (0, 1, 2...)
  token_count Int? // Số lượng token tương ứng với đoạn chunk này
  embedding   Unsupported("vector(1536)")? // Vector nhúng 1536 chiều sinh từ OpenAI/Gemini Embedding API (pgvector)
  created_at  DateTime                     @default(now()) @db.Timestamptz // Thời điểm tạo chunk

  // Relations
  document Document @relation(fields: [doc_id], references: [doc_id], onDelete: Cascade)

  @@index([doc_id], map: "idx_document_chunks_doc")
  @@map("document_chunks")
}

// ================================================================
// BẢNG: ai_conversations
// Mô tả: Lưu trữ lịch sử hỏi đáp giữa Học sinh / Gia sư với Trợ lý AI (AI Tutor Assistant).
// Quan hệ: Có thể gắn với 1 buổi học cụ thể (session_id) hoặc 1 khóa học (course_id) để khoanh vùng bối cảnh (Context Scope).
// ================================================================
model AIConversation {
  conversation_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bản ghi tin nhắn AI
  user_id         String   @db.Uuid // Khóa ngoại liên kết tới users.user_id (người thực hiện hỏi AI)
  course_id       String?  @db.Uuid // FK tới courses.course_id - Nếu hỏi AI trong phạm vi khóa học
  role            String // Vai trò người gửi ("user" = câu hỏi học sinh, "assistant" = câu trả lời AI, "system" = prompt hệ thống)
  message         String // Nội dung văn bản của câu hỏi hoặc câu trả lời AI
  model_used      String? // Tên mô hình AI được sử dụng (VD: "gpt-4o", "gemini-1.5-pro")
  tokens_used     Int? // Tổng số token tiêu tốn (dùng để đo lường chi phí API)
  timestamp       DateTime @default(now()) @db.Timestamptz // Thời điểm phát sinh câu hỏi/câu trả lời
  created_at      DateTime @default(now()) @db.Timestamptz // Thời điểm tạo bản ghi

  // Relations
  user   User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course Course? @relation(fields: [course_id], references: [course_id], onDelete: SetNull)

  @@index([user_id, timestamp(sort: Desc)], map: "idx_ai_conversations_user")
  @@map("ai_conversations")
}

// ================================================================
// MODULE 9: QUIZ (Bài kiểm tra trắc nghiệm & Tự luận)
// ================================================================

// Phân loại kiểu câu hỏi trong đề kiểm tra
enum QuizQuestionType {
  multiple_choice // Trắc nghiệm chọn 1 đáp án đúng từ các phương án (A, B, C, D)
  true_false // Độc lập dạng Chọn Đúng / Sai
  fill_in_blank // Điền câu trả lời ngắn vào chỗ trống
  essay // Tự luận (cần giáo viên hoặc AI chấm điểm chi tiết)
}

// Trạng thái của bài kiểm tra
enum QuizStatus {
  draft // Bản nháp: Gia sư hoặc AI đang tạo đề, học sinh chưa nhìn thấy
  published // Đã phát hành: Học sinh có thể vào làm bài kiểm tra
  archived // Lưu trữ: Đã đóng, dùng để lưu lịch sử làm bài
}

// ================================================================
// BẢNG: quizzes
// Mô tả: Quản lý danh mục bài kiểm tra / đề thi gắn với từng Khóa học.
// Điểm nổi bật: Hỗ trợ tính năng AI tự động sinh đề thi từ tài liệu (generated_by_ai = true).
// ================================================================
model Quiz {
  quiz_id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bài quiz
  course_id          String     @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa các bài quiz)
  title              String // Tiêu đề bài kiểm tra (VD: "Kiểm tra 15 phút - Đạo hàm & Tiệm cận")
  description        String? // Mô tả hướng dẫn hoặc lưu ý khi học sinh làm bài
  generated_by_ai    Boolean    @default(false) // Cờ đánh dấu đề thi do AI tự động khởi tạo từ tài liệu học tập
  ai_model_version   String? // Phiên bản mô hình AI sinh đề (VD: "gpt-4o", "gemini-1.5-flash")
  time_limit_minutes Int? // Thời gian giới hạn làm bài tính bằng phút (null = làm tự do không giới hạn thời gian)
  max_attempts       Int        @default(1) // Số lần làm bài tối đa của 1 học sinh (mặc định 1 lần)
  passing_score      Int?       @db.SmallInt // Điểm tối thiểu để được tính là Đạt / Qua bài thi (VD: 5/10)
  status             QuizStatus @default(draft) // Trạng thái bài kiểm tra (draft -> published -> archived)
  created_at         DateTime   @default(now()) @db.Timestamptz // Thời điểm tạo bài quiz

  // Relations
  course    Course         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([course_id, status], map: "idx_quizzes_course")
  @@map("quizzes")
}

// ================================================================
// BẢNG: quiz_questions
// Mô tả: Lưu trữ danh sách các câu hỏi trong đề thi.
// Thiết kế: Sử dụng options_json lưu mảng các phương án trắc nghiệm giúp render UI cực kỳ linh hoạt.
// ================================================================
model QuizQuestion {
  question_id   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho câu hỏi
  quiz_id       String           @db.Uuid // Khóa ngoại liên kết tới quizzes.quiz_id (Xóa bài quiz -> xóa các câu hỏi)
  question_text String // Nội dung văn bản câu hỏi
  question_type QuizQuestionType @default(multiple_choice) // Phân loại kiểu câu hỏi (multiple_choice, true_false...)
  explanation   String? // Lời giải chi tiết / Hướng dẫn phương pháp giải giúp học sinh ôn luyện
  points        Int              @default(1) @db.SmallInt // Điểm số tương ứng với câu hỏi (mặc định = 1)
  order_index   Int              @default(0) // Thứ tự hiển thị của câu hỏi trong đề thi (0, 1, 2...)
  created_at    DateTime         @default(now()) @db.Timestamptz // Thời điểm tạo câu hỏi

  // Relations
  quiz    Quiz         @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  options QuizOption[]

  @@index([quiz_id, order_index], map: "idx_quiz_questions_quiz")
  @@map("quiz_questions")
}

// ================================================================
// BẢNG: quiz_options
// Mô tả: Lưu trữ các phương án lựa chọn trắc nghiệm cho từng câu hỏi.
// Thiết kế: Chuẩn hóa 3NF tách riêng khỏi QuizQuestion giúp chấm điểm chính xác và chống lệch dữ liệu.
// ================================================================
model QuizOption {
  option_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho lựa chọn đáp án
  question_id String   @db.Uuid // Khóa ngoại liên kết tới quiz_questions.question_id (Xóa câu hỏi -> xóa các lựa chọn)
  content     String // Nội dung phương án lựa chọn (VD: "Đáp án A: 12", "Hà Nội")
  is_correct  Boolean  @default(false) // Đánh dấu đây có phải đáp án đúng hay không (true = đúng)
  order_index Int      @default(0) // Thứ tự hiển thị của phương án trong câu hỏi (0, 1, 2...)
  created_at  DateTime @default(now()) @db.Timestamptz // Thời điểm tạo phương án

  // Relations
  question QuizQuestion @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@index([question_id, order_index], map: "idx_quiz_options_question")
  @@map("quiz_options")
}

// ================================================================
// BẢNG: quiz_attempts
// Mô tả: Lưu trữ kết quả thực tế từng lần học sinh tham gia làm bài thi.
// Luồng: Học sinh bấm làm -> Lưu started_at -> Học sinh nộp bài -> Tự động tính score, duration_seconds, is_passed.
// ================================================================
model QuizAttempt {
  attempt_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho lượt làm bài
  student_id       String    @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id (học sinh tham gia làm bài)
  quiz_id          String    @db.Uuid // Khóa ngoại liên kết tới quizzes.quiz_id (bài quiz được thực hiện)
  score            Decimal?  @db.Decimal(5, 2) // Điểm số học sinh đạt được (VD: 8.50)
  total_points     Int? // Tổng điểm tối đa của đề thi tại thời điểm làm bài
  answers_json     Json?     @default("[]") // Mảng JSON lưu trữ danh sách các câu trả lời học sinh đã nộp
  started_at       DateTime  @default(now()) @db.Timestamptz // Thời điểm bắt đầu làm bài
  completed_at     DateTime? @db.Timestamptz // Thời điểm học sinh hoàn thành và nộp bài
  duration_seconds Int? // Thời gian thực tế học sinh làm bài (tính bằng giây)
  is_passed        Boolean? // Cờ đánh dấu học sinh có Đạt hay không (score >= passing_score)
  created_at       DateTime  @default(now()) @db.Timestamptz // Thời điểm lưu lượt làm bài

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  quiz    Quiz           @relation(fields: [quiz_id], references: [quiz_id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_quiz_attempts_student")
  @@index([quiz_id], map: "idx_quiz_attempts_quiz")
  @@map("quiz_attempts")
}

// ================================================================
// MODULE 10: ADMIN & SYSTEM (Quản trị hệ thống & Bảng vẽ)
// ================================================================

// ================================================================
// BẢNG: admin_logs
// Mô tả: Nhật ký ghi vết mọi hành động quản trị của Admin (Audit Log / Audit Trail).
// Mục đích: Phục vụ bảo mật, truy vết sự cố, kiểm tra quyền hạn và đảm bảo tính minh bạch hệ thống.
// ================================================================
model AdminLog {
  log_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bản ghi audit log
  admin_id     String   @db.Uuid // Khóa ngoại liên kết tới users.user_id (tài khoản Admin thực hiện thao tác)
  action       String // Tên hành động quản trị (VD: "APPROVE_TUTOR", "SUSPEND_USER", "REFUND_BOOKING")
  target_type  String // Phân loại đối tượng chịu tác động (VD: "USER", "TUTOR_PROFILE", "BOOKING", "PAYOUT")
  target_id    String?  @db.Uuid // Mã ID định danh của đối tượng chịu tác động
  details_json Json? // Mảng JSON ghi nhận chi tiết dữ liệu trước và sau khi Admin thay đổi
  ip_address   String? // Địa chỉ IP của Admin tại thời điểm gửi yêu cầu thao tác
  created_at   DateTime @default(now()) @db.Timestamptz // Thời điểm thực hiện hành động quản trị

  // Relations
  admin User @relation(fields: [admin_id], references: [user_id])

  @@index([admin_id, created_at(sort: Desc)], map: "idx_admin_logs_admin")
  @@index([target_type, target_id], map: "idx_admin_logs_target")
  @@map("admin_logs")
}

// ================================================================
// BẢNG: system_configs
// Mô tả: Lưu trữ các tham số cấu hình động toàn hệ thống dưới dạng cặp Khóa - Giá trị (Key-Value).
// Ưu điểm: Cho phép Admin thay đổi tham số kinh doanh (tỷ lệ hoa hồng, kích thước file...) mà không cần sửa code/re-deploy.
// ================================================================
model SystemConfig {
  config_key   String   @id // Khóa chính đại diện tên cấu hình (VD: "COMMISSION_RATE", "MAX_FILE_SIZE_MB", "MAINTENANCE_MODE")
  config_value String? // Giá trị cấu hình tương ứng dưới dạng chuỗi (VD: "15.0", "50", "false")
  description  String? // Mô tả ý nghĩa và mục đích sử dụng của tham số cấu hình này
  updated_at   DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật giá trị cấu hình mới nhất

  @@map("system_configs")
}

// ================================================================
// MODULE 11: ARTICLE & COMMENT (Bài viết & Bình luận)
// ================================================================

// ================================================================
// BẢNG: article_categories
// Mô tả: Danh mục bài viết do Admin quản lý (thêm/sửa/xóa).
// ================================================================
model ArticleCategory {
  category_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique // Tên danh mục (VD: "Bí quyết ôn thi", "Tin tức giáo dục")
  slug        String   @unique // Đường dẫn thân thiện SEO (VD: "bi-quyet-on-thi")
  description String?  // Mô tả ngắn gọn về danh mục
  order_index Int      @default(0) // Thứ tự hiển thị
  is_active   Boolean  @default(true) // Trạng thái kích hoạt
  created_at  DateTime @default(now()) @db.Timestamptz

  articles Article[]

  @@map("article_categories")
}

// ================================================================
// BẢNG: articles
// Mô tả: Quản lý các bài viết tin tức, bí quyết ôn thi, kinh nghiệm học tập và thông báo hệ thống.
// Thiết kế: Sử dụng kiểu dữ liệu Json cho content để lưu trữ nội dung Rich Text Block dạng EditorJS.
// ================================================================
model Article {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bài viết
  title         String // Tiêu đề bài viết (VD: "Bí quyết đạt 8.0 IELTS trong 6 tháng")
  slug          String?   @unique // Đường dẫn chuẩn SEO (VD: "bi-quyet-dat-8-0-ielts")
  excerpt       String // Đoạn trích dẫn ngắn / Tóm tắt nội dung bài viết
  content       Json // Nội dung chi tiết bài viết dưới dạng mảng JSON Rich Text Blocks
  thumbnail_url String? // Đường dẫn URL ảnh đại diện bài viết
  imageType     String? // Giữ lại trường cũ tránh mất dữ liệu
  published_at  DateTime? @db.Timestamptz // Thời điểm xuất bản bài viết
  author        String? // Giữ lại tên tác giả chuỗi cũ
  author_id     String?   @db.Uuid // Khóa ngoại liên kết tới users.user_id (Gia sư/Admin đăng bài)
  category      String? // Giữ lại tên danh mục chuỗi cũ
  category_id   String?   @db.Uuid // Khóa ngoại liên kết tới article_categories.category_id
  commentsCount Int       @default(0) // Tổng số lượng bình luận
  tags          Json // Mảng JSON chứa các từ khóa thẻ tag
  created_at    DateTime  @default(now()) @db.Timestamptz // Thời điểm tạo bài viết
  updated_at    DateTime  @default(now()) @db.Timestamptz // Thời điểm cập nhật bài viết gần nhất

  // Relations
  author_user       User?            @relation(fields: [author_id], references: [user_id], onDelete: SetNull)
  category_relation ArticleCategory? @relation(fields: [category_id], references: [category_id], onDelete: SetNull)
  comments          ArticleComment[]

  @@index([author_id], map: "idx_articles_author")
  @@index([category_id, published_at(sort: Desc)], map: "idx_articles_category")
  @@index([published_at(sort: Desc)], map: "idx_articles_published")
  @@map("articles")
}

// ================================================================
// BẢNG: article_comments
// Mô tả: Lưu trữ các bình luận trao đổi của học sinh/gia sư bên dưới mỗi bài viết blog/tin tức.
// Quan hệ: N-1 với articles (article_id) và users (user_id).
// ================================================================
model ArticleComment {
  comment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bình luận bài viết
  article_id String   @db.Uuid // Khóa ngoại liên kết tới articles.id (Xóa bài viết -> xóa các bình luận)
  user_id    String   @db.Uuid // Khóa ngoại liên kết tới users.user_id (người viết bình luận)
  content    String // Nội dung văn bản bình luận
  is_visible Boolean  @default(true) // Trạng thái hiển thị (true = công khai, false = ẩn do vi phạm)
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm gửi bình luận
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm chỉnh sửa bình luận

  // Relations
  article Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([article_id, created_at(sort: Desc)], map: "idx_article_comments_article")
  @@index([user_id], map: "idx_article_comments_user")
  @@map("article_comments")
}

// ================================================================
// BẢNG: course_comments
// Mô tả: Lưu trữ các bình luận hỏi đáp, thắc mắc công khai của người dùng trên trang chi tiết Khóa học.
// Phân biệt: Khác với Review (Module 7 - chỉ viết sau khi học xong), CourseComment dành cho thảo luận trước khi mua.
// ================================================================
model CourseComment {
  comment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bình luận khóa học
  course_id  String   @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa bình luận)
  user_id    String   @db.Uuid // Khóa ngoại liên kết tới users.user_id (người đăng thắc mắc/bình luận)
  content    String // Nội dung văn bản thắc mắc hoặc thảo luận
  rating     Int?     @db.SmallInt // Điểm số đánh giá tùy chọn (giữ lại hỗ trợ dữ liệu cũ)
  is_visible Boolean  @default(true) // Trạng thái hiển thị (true = công khai, false = ẩn do vi phạm)
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo bình luận
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật bình luận

  // Relations
  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([course_id, created_at(sort: Desc)], map: "idx_course_comments_course")
  @@index([user_id], map: "idx_course_comments_user")
  @@map("course_comments")
}

// ================================================================
// MODULE 12: GIA SƯ OFFLINE & BẢNG GIÁ THAM KHẢO
// ================================================================

enum ClassRequestStatus {
  PENDING_ADMIN // Mới tạo, chờ Admin kiểm tra và duyệt mở lớp
  WAITING_TUTOR_CONFIRM // Gia sư đã được chọn, đang chờ thanh toán phí nhận lớp
  OPEN // Lớp chưa giao / Đang cần gia sư (Hiển thị danh sách công khai)
  ASSIGNED // Gia sư đã thanh toán phí, lớp đã xác nhận hoàn tất
  REJECTED // Admin từ chối yêu cầu
  CANCELLED // Học viên hủy yêu cầu
  EXPIRED // Hết 48 giờ mà gia sư không thanh toán phí nhận lớp
}

enum ClassApplicationStatus {
  PENDING              // Đã gửi đơn ứng tuyển nhanh, chờ Admin duyệt
  APPROVED             // Được Admin chọn và giao lớp
  APPROVED_WAITING_FEE // Được duyệt, đang chờ gia sư thanh toán phí (legacy)
  REJECTED             // Bị từ chối
}

model ClassRequest {
  request_id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String? @unique // Mã lớp học hiển thị (VD: MS: 89513)
  student_id          String? @db.Uuid // FK tới student_profiles.student_id (nếu học viên đăng nhập)
  student_name        String // Họ tên học viên / phụ huynh
  phone               String // Số điện thoại liên hệ
  email               String? // Email liên hệ
  address_detail      String // Địa chỉ chi tiết (VD: tỉnh lộ 43 - Bình Chiểu)
  district            String? // Quận / Huyện (VD: Q.Thủ Đức)
  province            String? // Tỉnh / Thành phố (VD: Hồ Chí Minh)
  grade_id            String? @db.Uuid // FK → grades.grade_id (lớp cần dạy, chuẩn hóa)
  subject_name        String // Môn dạy (VD: Tiếng Anh, Toán)
  subject_id          String? @db.Uuid // FK tùy chọn tới subjects.subject_id
  num_students        Int     @default(1) // Số lượng học sinh
  academic_level      String? // Học lực hiện tại / Thông tin học sinh (VD: Nam, học giỏi)
  sessions_per_week   Int     @default(2) // Số buổi (VD: 2 buổi/tuần)
  study_time          String? // Thời gian học (VD: Dạy 120 phút/buổi, các tối 18h-20h)
  tutor_requirement   String? // Yêu cầu gia sư (VD: Nữ Sinh Viên, Giáo Viên)
  selected_tutor_id   String? @db.Uuid // UUID gia sư được chọn (nếu có trong hệ thống)
  selected_tutor_code String? // Mã số/tên gia sư học viên điền thủ công (VD: 7650, 2907)
  desired_price       Decimal @default(0) @db.Decimal(12, 2) // Mức lương / giá tiền mong muốn (VNĐ/tháng)

  commission_rate    Decimal            @default(35) @db.Decimal(5, 2) // Phí nhận lớp (%) (VD: 35%, 30%)
  other_requirements String? // Yêu cầu khác
  status             ClassRequestStatus @default(PENDING_ADMIN)
  assigned_tutor_id  String?            @db.Uuid // Gia sư chính thức được chọn
  payment_deadline   DateTime?          @db.Timestamptz // Hạn thanh toán phí nhận lớp (WAITING_TUTOR_CONFIRM + 48 giờ)
  fee_amount         Decimal?           @db.Decimal(12, 2) // Số tiền phí nhận lớp = desired_price * commission_rate / 100
  created_at         DateTime           @default(now()) @db.Timestamptz
  updated_at         DateTime           @default(now()) @db.Timestamptz

  // Relations
  student        StudentProfile?    @relation(fields: [student_id], references: [student_id], onDelete: SetNull)
  subject        Subject?           @relation(fields: [subject_id], references: [subject_id], onDelete: SetNull)
  grade          Grade?             @relation(fields: [grade_id], references: [grade_id], onDelete: SetNull)
  selected_tutor TutorProfile?      @relation("SelectedTutor", fields: [selected_tutor_id], references: [tutor_id], onDelete: SetNull)
  assigned_tutor TutorProfile?      @relation("AssignedTutor", fields: [assigned_tutor_id], references: [tutor_id], onDelete: SetNull)
  applications   ClassApplication[]

  @@index([status, created_at(sort: Desc)], map: "idx_class_requests_status")
  @@index([province, district], map: "idx_class_requests_location")
  @@map("class_requests")
}

model ClassApplication {
  application_id   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_request_id String                 @db.Uuid
  tutor_id         String?                @db.Uuid // FK tùy chọn tới tutor_profiles.tutor_id
  applicant_phone  String // Số điện thoại người đăng ký nhận lớp
  available_from   DateTime?              @db.Date // Ngày có thể bắt đầu nhận lớp sớm nhất
  notes            String? // Yêu cầu thêm / Ghi chú
  status           ClassApplicationStatus @default(PENDING)
  created_at       DateTime               @default(now()) @db.Timestamptz
  updated_at       DateTime               @default(now()) @db.Timestamptz

  // Relations
  class_request ClassRequest  @relation(fields: [class_request_id], references: [request_id], onDelete: Cascade)
  tutor         TutorProfile? @relation(fields: [tutor_id], references: [tutor_id], onDelete: SetNull)

  @@index([class_request_id], map: "idx_class_applications_request")
  @@index([tutor_id], map: "idx_class_applications_tutor")
  @@map("class_applications")
}

// ================================================================
// BẢNG: reference_prices
// Mô tả: Bảng giá tham khảo lương gia sư theo khối lớp và số buổi/tuần.
//        Dùng min/max Decimal thay vì String "600 - 700" để so sánh/filter chính xác.
// ================================================================
model ReferencePrice {
  price_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grade_group         String // LỚP 1, 2, 3, 4 | LỚP 5, 6, 7, 8 | LỚP 9, 10, 11, 12 | LTDH - NGOẠI NGỮ
  sessions_per_week   Int // 2, 3, 4, 5
  student_tutor_price String // e.g. "600 - 700" (k/tháng)
  teacher_tutor_price String // e.g. "1100 - 1300" (k/tháng)
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  @@map("reference_prices")
}
