generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext, pg_trgm, vector, unaccent]
}

// ================================================================
// MODULE 1: USER & AUTHENTICATION (Tài khoản người dùng & Xác thực)
// ================================================================

// Phân quyền người dùng trong hệ thống
enum UserRole {
  student // Học sinh: có thể tìm gia sư, đặt lịch, làm quiz, chat
  tutor   // Gia sư: tạo khóa học, dạy học, quản lý lịch, nhận tiền
  admin   // Quản trị viên: duyệt hồ sơ gia sư, quản lý hệ thống, kiểm duyệt
}

// Trạng thái tài khoản người dùng
enum UserStatus {
  active    // Hoạt động bình thường
  suspended // Bị tạm khóa (khi vi phạm quy định hoặc đang chờ xác minh)
  deleted   // Đã xóa tài khoản (soft delete)
}

// ================================================================
// BẢNG: users
// Mô tả: Lưu thông tin tài khoản của tất cả người dùng trong hệ thống.
//        Là bảng trung tâm liên kết với mọi module khác (Tutor, Student, Booking, Chat...).
// Quan hệ: 1 User có 1 TutorProfile HOẶC 1 StudentProfile (tùy role).
// ================================================================
model User {
  user_id         String     @id @db.Uuid // Khóa chính UUID (mỗi user có 1 mã định danh duy nhất)
  email           String     @unique @db.Citext // Email đăng nhập, @unique chống trùng, @db.Citext không phân biệt hoa/thường (VD: A@g.com = a@g.com)
  full_name       String     // Họ và tên đầy đủ của người dùng
  phone           String?    // Số điện thoại liên hệ (tùy chọn)
  avatar_url      String?    // Đường dẫn ảnh đại diện (lưu trên CDN/Cloud Storage)
  date_of_birth   DateTime?  @db.Date // Ngày tháng năm sinh (chỉ lưu ngày, dùng tính tuổi/lọc lứa tuổi)
  gender          String?    // Giới tính ("male" | "female" | "other")
  bio             String?    // Tiểu sử/Giới thiệu ngắn về bản thân
  role            UserRole   @default(student) // Phân quyền (mặc định là học sinh khi đăng ký)
  status          UserStatus @default(active) // Trạng thái tài khoản (mặc định active)
  email_verified  Boolean    @default(false) // Trạng thái xác thực email (Nodemailer gửi link → click → true)
  social_provider String?    // Nhà cung cấp đăng nhập MXH (Google, Facebook...) nếu có
  social_id       String?    // ID duy nhất từ Google/Facebook trả về
  created_at      DateTime   @default(now()) @db.Timestamptz // Thời điểm tạo tài khoản (có kèm múi giờ)
  updated_at      DateTime   @default(now()) @db.Timestamptz // Thời điểm cập nhật thông tin mới nhất
  last_login_at   DateTime?  @db.Timestamptz // Lần đăng nhập cuối cùng (dùng để thống kê active user)

  // Relations
  tutor_profile      TutorProfile?
  student_profile    StudentProfile?
  wallets            Wallet?
  user_addresses     UserAddress[]
  admin_logs         AdminLog[]
  attendances        Attendance[]
  session_recordings SessionRecording[]
  messages           Message[]
  documents          Document[]
  ai_conversations   AIConversation[]
  whiteboard_states  WhiteboardState[]
  tutor_certificates TutorCertificate[]
  bookings           Booking[]
  transactions       Transaction[]
  article_comments   ArticleComment[]
  course_comments    CourseComment[]

  @@index([role, status], map: "idx_users_role_status")
  @@index([social_provider, social_id], map: "idx_users_social")
  @@map("users")
}

// ================================================================
// BẢNG: user_addresses
// Mô tả: Lưu địa chỉ của người dùng. Tách thành bảng riêng để 1 user
//        có thể có nhiều địa chỉ (VD: nhà riêng, nơi làm việc, địa điểm học).
// ================================================================
model UserAddress {
  address_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID tự sinh
  user_id    String   @db.Uuid // Khóa ngoại liên kết tới users.user_id
  province   String?  // Tỉnh / Thành phố (VD: Hà Nội, TP.HCM)
  district   String?  // Quận / Huyện (VD: Cầu Giấy, Quận 1)
  ward       String?  // Phường / Xã (VD: Dịch Vọng, Bến Nghé)
  detail     String?  // Địa chỉ chi tiết (số nhà, tên đường...)
  is_default Boolean  @default(false) // Đánh dấu là địa chỉ mặc định
  created_at DateTime @default(now()) @db.Timestamptz // Ngày tạo địa chỉ

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_addresses_user")
  @@map("user_addresses")
}

// ================================================================
// MODULE 2: TUTOR & STUDENT PROFILE (Hồ sơ Gia sư & Học sinh)
// ================================================================

// Hình thức giảng dạy của gia sư / học sinh ưu tiên
enum TeachingMode {
  online  // Dạy online (qua video call, whiteboard)
  offline // Dạy trực tiếp tại nhà/trung tâm
  both    // Linh hoạt cả 2 hình thức
}

// Trạng thái xét duyệt hồ sơ / bằng cấp bởi Admin
enum VerificationStatus {
  pending  // Đang chờ Admin xem xét và duyệt
  approved // Đã được duyệt, hợp lệ
  rejected // Bị từ chối (Admin ghi lý do ở admin_note)
}

// ================================================================
// BẢNG: tutor_profiles
// Mô tả: Hồ sơ chuyên nghiệp của Gia sư. Tách riêng khỏi bảng users 
//        để tối ưu hóa và chỉ áp dụng cho người dùng có role = tutor.
// Quan hệ: 1-1 với users (user_id @unique). 1 Tutor có nhiều Certificate, Course, Payout...
// ================================================================
model TutorProfile {
  tutor_id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID riêng cho hồ sơ gia sư
  user_id          String             @unique @db.Uuid // Khóa ngoại liên kết 1-1 với users.user_id
  bio              String?            // Giới thiệu chuyên môn & phương pháp giảng dạy
  education        String?            // Trình độ học vấn (VD: Thạc sĩ Toán học - ĐH Sư Phạm)
  experience_years Int?               @default(0) @db.SmallInt // Số năm kinh nghiệm dạy học (SmallInt tiết kiệm bộ nhớ)
  hourly_rate      Decimal            @default(0) @db.Decimal(10, 2) // Mức học phí/giờ (VD: 200000.00 VND). Dùng Decimal tránh mất xu
  subjects         Json               @default("[]") // Mảng JSON chứa các môn dạy (VD: ["Toán", "Vật Lý"])
  specialties      Json?              @default("[]") // Mảng JSON chứa chuyên môn đặc biệt (VD: ["Luyện thi ĐH", "IELTS 8.0"])
  rating           Decimal?           @default(0) @db.Decimal(2, 1) // Điểm đánh giá trung bình từ học sinh (0.0 -> 5.0)
  review_count     Int                @default(0) // Tổng số lượng đánh giá nhận được (lưu denormalized để query nhanh)
  teaching_mode    TeachingMode       @default(both) // Hình thức dạy (online/offline/both)
  province         String?            // Tỉnh/Thành phố nhận dạy offline
  district         String?            // Quận/Huyện nhận dạy offline
  verified_status  VerificationStatus @default(pending) // Trạng thái phê duyệt hồ sơ gia sư từ Admin
  is_featured      Boolean            @default(false) // Đánh dấu gia sư nổi bật (ưu tiên hiển thị ở trang chủ)
  created_at       DateTime           @default(now()) @db.Timestamptz // Thời điểm tạo hồ sơ
  updated_at       DateTime           @default(now()) @db.Timestamptz // Thời điểm cập nhật hồ sơ gần nhất

  // Relations
  user          User               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certificates  TutorCertificate[]
  courses       Course[]
  payouts       Payout[]
  reviews       Review[]
  favorites     Favorite[]
  matching_logs MatchingLog[]

  @@index([verified_status, rating(sort: Desc)], map: "idx_tutor_profiles_verified")
  @@index([hourly_rate], map: "idx_tutor_profiles_rate")
  @@index([province, district], map: "idx_tutor_profiles_location")
  @@index([subjects], type: Gin, map: "idx_tutor_profiles_subjects")
  @@map("tutor_profiles")
}

// ================================================================
// BẢNG: student_profiles
// Mô tả: Hồ sơ thông tin học tập của Học sinh. Dùng làm dữ liệu đầu vào
//        cho thuật toán AI Matching để gợi ý Gia sư phù hợp.
// Quan hệ: 1-1 với users (user_id @unique).
// ================================================================
model StudentProfile {
  student_id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID riêng cho hồ sơ học sinh
  user_id            String        @unique @db.Uuid // Khóa ngoại liên kết 1-1 với users.user_id
  grade_level        String?       // Cấp học hiện tại (VD: Lớp 10, Đại học năm 2, Người đi làm...)
  learning_goals     String?       // Mục tiêu học tập (VD: Ôn thi ĐH top đầu, Lấy bằng IELTS 7.0)
  preferred_subjects Json?         @default("[]") // Mảng JSON các môn muốn học (VD: ["Hóa học", "Tiếng Anh"])
  preferred_mode     TeachingMode? // Hình thức học ưu tiên (online/offline)
  budget_min         Decimal?      @db.Decimal(10, 2) // Ngân sách tối thiểu chấp nhận chi trả / giờ
  budget_max         Decimal?      @db.Decimal(10, 2) // Ngân sách tối đa chấp nhận chi trả / giờ (AI matching dùng khoảng min-max)
  created_at         DateTime      @default(now()) @db.Timestamptz // Thời điểm tạo hồ sơ
  updated_at         DateTime      @default(now()) @db.Timestamptz // Thời điểm cập nhật gần nhất

  // Relations
  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  quiz_attempts QuizAttempt[]
  matching_logs MatchingLog[]

  @@map("student_profiles")
}

// ================================================================
// BẢNG: tutor_certificates
// Mô tả: Quản lý bằng cấp, chứng chỉ chuyên môn của gia sư upload lên.
// Luồng hoạt động: Upload -> pending -> Admin duyệt (approved/rejected kèm admin_note).
// ================================================================
model TutorCertificate {
  cert_id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho chứng chỉ
  tutor_id          String             @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id
  title             String             // Tên bằng cấp / chứng chỉ (VD: Bằng Thạc sĩ Sư Phạm, IELTS 8.0)
  file_url          String             // Đường dẫn lưu file scan bằng cấp (lưu trên CDN/Cloud)
  file_type         String?            // Định dạng file (PDF, PNG, JPG)
  issued_by         String?            // Nơi cấp (VD: Đại học Quốc Gia, British Council)
  issued_date       DateTime?          @db.Date // Ngày cấp bằng (chỉ lưu ngày)
  expiry_date       DateTime?          @db.Date // Ngày hết hạn chứng chỉ (nếu có, VD: IELTS hết hạn sau 2 năm)
  verified_by_admin String?            @db.Uuid // FK tới users.user_id - Ghi nhận Admin nào đã duyệt bằng này
  status            VerificationStatus @default(pending) // Trạng thái xét duyệt (pending, approved, rejected)
  admin_note        String?            // Ghi chú của Admin (bắt buộc điền lý do khi từ chối/rejected)
  created_at        DateTime           @default(now()) @db.Timestamptz // Ngày upload
  updated_at        DateTime           @default(now()) @db.Timestamptz // Ngày cập nhật trạng thái duyệt

  // Relations
  tutor TutorProfile @relation(fields: [tutor_id], references: [tutor_id], onDelete: Cascade)
  admin User?        @relation(fields: [verified_by_admin], references: [user_id], onDelete: SetNull)

  @@index([tutor_id], map: "idx_certificates_tutor")
  @@index([status], map: "idx_certificates_status")
  @@map("tutor_certificates")
}

// ================================================================
// MODULE 3: COURSE & SCHEDULE (Khóa học & Lịch giảng dạy)
// ================================================================

// Trạng thái hiển thị / phát hành của khóa học
enum CourseStatus {
  draft     // Bản nháp: Gia sư đang tạo, chưa mở đăng ký cho học sinh thấy
  published // Đã đăng: Hiển thị trên danh sách tìm kiếm, học sinh có thể đặt lịch
  hidden    // Tạm ẩn: Không xuất hiện ở tìm kiếm (VD: Gia sư tạm ngừng nhận thêm lớp)
  archived  // Lưu trữ: Khóa học đã kết thúc hẳn, dùng để lưu lịch sử
}

// ================================================================
// BẢNG: courses
// Mô tả: Quản lý thông tin các khóa học do Gia sư tạo ra.
// Luồng: Gia sư tạo draft -> thêm lịch học -> chuyển sang published -> Học sinh chọn đặt lịch.
// ================================================================
model Course {
  course_id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho khóa học
  tutor_id         String       @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id (Xóa tutor -> xóa khóa học)
  title            String       // Tên khóa học (VD: "Toán 12 luyện thi THPT Quốc Gia")
  subject          String       // Môn học chính (VD: "Toán", "Vật Lý", "Tiếng Anh") - dùng để tìm kiếm & lọc
  description      String?      // Mô tả nội dung, mục tiêu kiến thức & phương pháp giảng dạy
  price            Decimal      @db.Decimal(10, 2) // Học phí trọn gói khóa học (dùng Decimal tránh sai số tiền tệ)
  duration_minutes Int          @default(60) @db.SmallInt // Thời lượng mỗi buổi học tính bằng phút (VD: 60, 90, 120)
  max_students     Int          @default(1) @db.SmallInt // Số học sinh tối đa trong 1 lớp (1 = dạy 1-1, >1 = dạy nhóm)
  total_sessions   Int          @default(1) @db.SmallInt // Tổng số buổi học trong toàn bộ khóa (VD: 10 buổi, 20 buổi)
  level            String?      // Trình độ yêu cầu (VD: "Cơ bản", "Nâng cao", "Luyện thi 9+")
  status           CourseStatus @default(draft) // Trạng thái khóa học (draft, published, hidden, archived)
  thumbnail_url    String?      // Đường dẫn ảnh đại diện khóa học (hiển thị trên trang danh sách/tìm kiếm)
  tags             Json?        @default("[]") // Mảng JSON các từ khóa tìm kiếm (VD: ["THPT", "Luyện đề", "Ôn tập"]). Đánh chỉ mục GIN
  created_at       DateTime     @default(now()) @db.Timestamptz // Thời điểm tạo khóa học
  updated_at       DateTime     @default(now()) @db.Timestamptz // Thời điểm cập nhật thông tin gần nhất

  // Relations
  tutor            TutorProfile     @relation(fields: [tutor_id], references: [tutor_id], onDelete: Cascade)
  schedules        CourseSchedule[]
  bookings         Booking[]
  documents        Document[]
  ai_conversations AIConversation[]
  quizzes          Quiz[]
  comments         CourseComment[]

  @@index([tutor_id, status], map: "idx_courses_tutor")
  @@index([subject, status, price], map: "idx_courses_subject")
  @@index([status, created_at(sort: Desc)], map: "idx_courses_status")
  @@index([tags], type: Gin, map: "idx_courses_tags")
  @@map("courses")
}

// ================================================================
// BẢNG: course_schedules
// Mô tả: Quản lý các slot thời gian / khung giờ học cụ thể của từng khóa học.
//        Học sinh chọn khung giờ từ bảng này để tiến hành Đặt lịch (Booking).
// ================================================================
model CourseSchedule {
  schedule_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho slot lịch học
  course_id      String    @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa lịch)
  start_time     DateTime  @db.Timestamptz // Thời điểm bắt đầu buổi học (có kèm múi giờ)
  end_time       DateTime  @db.Timestamptz // Thời điểm kết thúc buổi học (có kèm múi giờ)
  is_recurring   Boolean   @default(false) // Lịch lặp lại theo tuần? (true = lặp lại, false = 1 lần)
  day_of_week    Int?      @db.SmallInt // Thứ trong tuần lặp lại (0=Chủ Nhật, 1=Thứ 2, 2=Thứ 3, ..., 6=Thứ 7)
  recurrence_end DateTime? @db.Date // Ngày kết thúc chuỗi lịch lặp lại (nếu is_recurring = true)
  is_booked      Boolean   @default(false) // Cờ đánh dấu slot đã đầy người đặt chưa (true = đã hết chỗ)
  max_slot       Int       @default(1) @db.SmallInt // Số chỗ tối đa cho khung giờ này (thường bằng max_students của Course)
  created_at     DateTime  @default(now()) @db.Timestamptz // Thời điểm tạo slot lịch

  // Relations
  course   Course    @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  bookings Booking[]

  @@index([course_id, start_time], map: "idx_schedules_course")
  @@index([is_booked, start_time], map: "idx_schedules_available")
  @@map("course_schedules")
}

// ================================================================
// MODULE 4: BOOKING & PAYMENT (Đặt lịch & Thanh toán)
// ================================================================

// ================================================================
// MODULE 4: BOOKING & PAYMENT (Đặt lịch & Thanh toán)
// ================================================================

// Trạng thái của Booking (tiến độ tổng thể đặt lịch)
enum BookingStatus {
  pending   // Chờ xác nhận: Vừa đặt, đang chờ gia sư xác nhận hoặc chờ học sinh hoàn tất thanh toán
  confirmed // Đã xác nhận: Học sinh đã thanh toán thành công, lịch học chính thức được duyệt
  completed // Đã hoàn thành: Tất cả các buổi học trong khóa đã dạy xong
  cancelled // Đã hủy: Lịch đặt bị hủy bởi học sinh hoặc gia sư
  refunded  // Đã hoàn tiền: Booking bị hủy hợp lệ và tiền đã được trả lại cho học sinh
}

// Trạng thái thanh toán của Booking
enum PaymentStatus {
  unpaid   // Chưa thanh toán: Khởi tạo ban đầu khi vừa bấm đặt lịch
  paid     // Đã thanh toán: Học sinh đã chuyển tiền thành công qua ZaloPay/Ví
  refunded // Đã hoàn tiền: Đã thực hiện refund lại cho học sinh
  failed   // Thanh toán thất bại: Do lỗi thẻ, hết hạn giao dịch hoặc lỗi cổng thanh toán
}

// Trạng thái của từng lần giao dịch thanh toán qua cổng (ZaloPay)
enum TransactionStatus {
  pending  // Đang xử lý: Đã tạo đơn trên ZaloPay, đang chờ callback kết quả
  success  // Thành công: ZaloPay xác nhận tiền đã vào tài khoản hệ thống
  failed   // Thất bại: Giao dịch bị lỗi, hủy hoặc quá thời hạn thanh toán
  refunded // Hoàn tiền: Giao dịch thanh toán này đã được thực hiện hoàn lại
}

// Trạng thái yêu cầu rút tiền của Gia sư
enum PayoutStatus {
  pending    // Chờ xử lý: Gia sư gửi yêu cầu rút tiền, Admin chưa duyệt
  processing // Đang chuyển khoản: Admin đã duyệt và đang thực hiện giao dịch ngân hàng
  completed  // Thành công: Tiền đã được chuyển thành công vào tài khoản ngân hàng gia sư
  failed     // Thất bại: Rút tiền không thành công (VD: Sai số tài khoản ngân hàng)
}

// ================================================================
// BẢNG: bookings
// Mô tả: Bảng trung tâm quản lý việc đặt lịch học của Học sinh với Khóa học/Lịch học.
// Luồng: Học sinh chọn lịch -> Tạo Booking (pending) -> Thanh toán -> confirmed -> Hoàn thành.
// Quan hệ: Liên kết StudentProfile, Course, CourseSchedule. Có quan hệ 1-N với Transaction, ClassSession.
// ================================================================
model Booking {
  booking_id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID riêng cho đơn đặt lịch
  student_id       String        @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id
  course_id        String        @db.Uuid // Khóa ngoại liên kết tới courses.course_id
  schedule_id      String        @db.Uuid // Khóa ngoại liên kết tới course_schedules.schedule_id (khung giờ được chọn)
  status           BookingStatus @default(pending) // Trạng thái tiến độ booking (pending -> confirmed -> completed)
  payment_status   PaymentStatus @default(unpaid) // Trạng thái thanh toán tiền (unpaid -> paid)
  total_amount     Decimal       @db.Decimal(10, 2) // Tổng tiền học phí cần thanh toán (VND)
  currency         String        @default("VND") // Đơn vị tiền tệ (mặc định VND)
  notes            String?       // Ghi chú của học sinh khi đặt lịch (yêu cầu riêng)
  cancelled_by     String?       @db.Uuid // FK tới users.user_id - Ghi nhận ai là người bấm hủy (học sinh hay gia sư)
  cancelled_reason String?       // Lý do hủy booking (bắt buộc khi trạng thái = cancelled)
  cancelled_at     DateTime?     @db.Timestamptz // Thời điểm thực hiện hủy booking
  created_at       DateTime      @default(now()) @db.Timestamptz // Thời điểm tạo đơn đặt lịch
  updated_at       DateTime      @default(now()) @db.Timestamptz // Thời điểm cập nhật trạng thái mới nhất

  // Relations
  student         StudentProfile @relation(fields: [student_id], references: [student_id])
  course          Course         @relation(fields: [course_id], references: [course_id])
  schedule        CourseSchedule @relation(fields: [schedule_id], references: [schedule_id])
  cancelledByUser User?          @relation(fields: [cancelled_by], references: [user_id], onDelete: SetNull)
  transactions    Transaction[]
  class_sessions  ClassSession[]
  chat_rooms      ChatRoom[]
  reviews         Review?

  @@index([student_id, status, created_at(sort: Desc)], map: "idx_bookings_student")
  @@index([course_id], map: "idx_bookings_course")
  @@index([schedule_id], map: "idx_bookings_schedule")
  @@map("bookings")
}

// ================================================================
// BẢNG: transactions
// Mô tả: Lưu lịch sử từng lần giao dịch thanh toán qua cổng thanh toán ZaloPay.
// Lý do tách riêng: 1 Booking có thể thử thanh toán nhiều lần nếu lần đầu bị lỗi.
// ================================================================
model Transaction {
  transaction_id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho giao dịch
  booking_id            String            @db.Uuid // Khóa ngoại liên kết tới bookings.booking_id (Xóa booking -> xóa transaction)
  user_id               String            @db.Uuid // Khóa ngoại liên kết tới users.user_id (người thực hiện thanh toán)
  amount                Decimal           @db.Decimal(10, 2) // Số tiền thanh toán thực tế (VND)
  payment_method        String            @default("zalopay") // Phương thức thanh toán ("zalopay", "wallet"...)
  zalopay_order_id      String?           // AppTransID do hệ thống gửi sang ZaloPay để tạo đơn
  zalopay_trans_id      String?           // Mã giao dịch chính thức do ZaloPay trả về sau khi thanh toán xong
  zalopay_callback_data Json?             // Mảng JSON lưu nguyên bản dữ liệu callback từ ZaloPay (phục vụ đối soát/audit)
  status                TransactionStatus @default(pending) // Trạng thái giao dịch (pending -> success / failed)
  paid_at               DateTime?         @db.Timestamptz // Thời điểm ZaloPay xác nhận đã nhận tiền
  created_at            DateTime          @default(now()) @db.Timestamptz // Thời điểm tạo giao dịch
  updated_at            DateTime          @default(now()) @db.Timestamptz // Thời điểm cập nhật trạng thái

  // Relations
  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [user_id])

  @@index([booking_id], map: "idx_transactions_booking")
  @@index([user_id, created_at(sort: Desc)], map: "idx_transactions_user")
  @@map("transactions")
}

// ================================================================
// BẢNG: wallets
// Mô tả: Ví tiền điện tử nội bộ của mỗi người dùng (đặc biệt là Gia sư).
// Luồng: Học sinh thanh toán -> Tiền sau khi trừ phí hoa hồng được cộng vào ví Gia sư -> Gia sư rút tiền.
// ================================================================
model Wallet {
  wallet_id  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID của ví
  user_id    String   @unique @db.Uuid // Khóa ngoại 1-1 với users.user_id (mỗi user chỉ có 1 ví duy nhất)
  balance    Decimal  @default(0) @db.Decimal(10, 2) // Số dư tài khoản hiện tại (VND)
  currency   String   @default("VND") // Đơn vị tiền tệ
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm khởi tạo ví
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm biến động số dư gần nhất

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("wallets")
}

// ================================================================
// BẢNG: payouts
// Mô tả: Quản lý các yêu cầu rút tiền của Gia sư từ Ví nội bộ về Tài khoản Ngân hàng thực tế.
// Luồng: Gia sư tạo Payout request -> Admin kiểm tra & duyệt -> Chuyển khoản -> completed.
// ================================================================
model Payout {
  payout_id    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID của đợt rút tiền
  tutor_id     String       @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id
  amount       Decimal      @db.Decimal(10, 2) // Số tiền gia sư yêu cầu rút (VND)
  period_start DateTime     @db.Date // Ngày bắt đầu kỳ đối soát doanh thu
  period_end   DateTime     @db.Date // Ngày kết thúc kỳ đối soát doanh thu
  bank_account String?      // Số tài khoản ngân hàng nhận tiền
  bank_name    String?      // Tên ngân hàng (VD: Vietcombank, MBBank, Techcombank)
  status       PayoutStatus @default(pending) // Trạng thái rút tiền (pending -> processing -> completed)
  processed_at DateTime?    @db.Timestamptz // Thời điểm Admin bấm duyệt hoàn tất chuyển khoản
  created_at   DateTime     @default(now()) @db.Timestamptz // Thời điểm gửi yêu cầu rút tiền

  // Relations
  tutor TutorProfile @relation(fields: [tutor_id], references: [tutor_id])

  @@index([tutor_id, created_at(sort: Desc)], map: "idx_payouts_tutor")
  @@index([status], map: "idx_payouts_status")
  @@map("payouts")
}

// ================================================================
// MODULE 5: CLASS SESSION & ATTENDANCE (Buổi học & Điểm danh)
// ================================================================

enum SessionStatus {
  scheduled // Đã lên lịch
  ongoing   // Đang diễn ra
  completed // Đã hoàn thành
  cancelled // Đã hủy
  no_show   // Vắng mặt không lý do
}

enum AttendanceStatus {
  present // Có mặt
  absent  // Vắng mặt
  late    // Đi muộn
  excused // Vắng có lý do
}

enum AttendanceMethod {
  manual // Điểm danh thủ công
  auto   // Điểm danh tự động qua hệ thống
  self   // Học sinh tự điểm danh
}

model ClassSession {
  session_id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id          String        @db.Uuid
  room_id             String
  title               String?
  scheduled_start     DateTime      @db.Timestamptz
  scheduled_end       DateTime      @db.Timestamptz
  actual_start        DateTime?     @db.Timestamptz
  actual_end          DateTime?     @db.Timestamptz
  status              SessionStatus @default(scheduled)
  whiteboard_snapshot String?
  notes               String?
  created_at          DateTime      @default(now()) @db.Timestamptz

  // Relations
  booking            Booking            @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  attendances        Attendance[]
  session_recordings SessionRecording[]
  chat_rooms         ChatRoom[]
  ai_conversations   AIConversation[]
  whiteboard_states  WhiteboardState[]

  @@index([booking_id, scheduled_start], map: "idx_sessions_booking")
  @@index([room_id], map: "idx_sessions_room")
  @@index([status, scheduled_start], map: "idx_sessions_status")
  @@map("class_sessions")
}

model Attendance {
  attendance_id    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String            @db.Uuid
  user_id          String            @db.Uuid
  check_in_time    DateTime?         @db.Timestamptz
  check_out_time   DateTime?         @db.Timestamptz
  duration_minutes Int?              @db.SmallInt
  status           AttendanceStatus  @default(absent)
  method           AttendanceMethod? @default(manual)
  created_at       DateTime          @default(now()) @db.Timestamptz

  // Relations
  session ClassSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [user_id])

  @@index([session_id], map: "idx_attendances_session")
  @@index([user_id], map: "idx_attendances_user")
  @@map("attendances")
}

model SessionRecording {
  recording_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String    @db.Uuid
  file_url         String
  file_size_mb     Decimal?  @db.Decimal(8, 2)
  duration_seconds Int?
  recorded_by      String    @db.Uuid
  is_processed     Boolean   @default(false)
  expires_at       DateTime? @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz

  // Relations
  session ClassSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  user    User         @relation(fields: [recorded_by], references: [user_id])

  @@index([session_id], map: "idx_recordings_session")
  @@map("session_recordings")
}

// ================================================================
// MODULE 6: CHAT & MESSAGING (Trò chuyện & Tin nhắn)
// ================================================================

enum MessageType {
  text       // Tin nhắn văn bản
  image      // Hình ảnh
  file       // Tệp tin tài liệu
  system     // Tin nhắn hệ thống
  whiteboard // Ảnh chụp bảng vẽ
}

enum RoomType {
  direct    // Chat trực tiếp 1-1
  group     // Chat nhóm
  classroom // Phòng chat trong lớp học
}

model ChatRoom {
  room_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id   String?  @db.Uuid
  booking_id   String?  @db.Uuid
  room_type    RoomType @default(direct)
  title        String?
  participants Json?    @default("[]")
  created_at   DateTime @default(now()) @db.Timestamptz

  // Relations
  session  ClassSession? @relation(fields: [session_id], references: [session_id], onDelete: SetNull)
  booking  Booking?      @relation(fields: [booking_id], references: [booking_id], onDelete: SetNull)
  messages Message[]

  @@index([session_id], map: "idx_chat_rooms_session")
  @@index([booking_id], map: "idx_chat_rooms_booking")
  @@index([participants], type: Gin, map: "idx_chat_rooms_participants")
  @@map("chat_rooms")
}

model Message {
  message_id   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id      String      @db.Uuid
  sender_id    String      @db.Uuid
  content      String?
  message_type MessageType @default(text)
  file_url     String?
  file_name    String?
  is_read      Boolean     @default(false)
  read_at      DateTime?   @db.Timestamptz
  reply_to     String?     @db.Uuid
  sent_at      DateTime    @default(now()) @db.Timestamptz
  created_at   DateTime    @default(now()) @db.Timestamptz

  // Relations
  room    ChatRoom  @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  sender  User      @relation(fields: [sender_id], references: [user_id])
  parent  Message?  @relation("MessageReplies", fields: [reply_to], references: [message_id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")

  @@index([room_id, sent_at(sort: Desc)], map: "idx_messages_room")
  @@index([sender_id, is_read], map: "idx_messages_sender")
  @@index([reply_to], map: "idx_messages_reply")
  @@map("messages")
}

// ================================================================
// MODULE 7: REVIEW, FAVORITE & MATCHING (Đánh giá, Yêu thích & Gợi ý)
// ================================================================

model Review {
  review_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String   @unique @db.Uuid
  student_id      String   @db.Uuid
  tutor_id        String   @db.Uuid
  rating          Int      @db.SmallInt
  professionalism Int?     @db.SmallInt
  communication   Int?     @db.SmallInt
  punctuality     Int?     @db.SmallInt
  comment         String?
  is_visible      Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz

  // Relations
  booking Booking        @relation(fields: [booking_id], references: [booking_id])
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@index([tutor_id, created_at(sort: Desc)], map: "idx_reviews_tutor")
  @@index([student_id], map: "idx_reviews_student")
  @@map("reviews")
}

model Favorite {
  favorite_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id  String   @db.Uuid
  tutor_id    String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@unique([student_id, tutor_id])
  @@index([student_id], map: "idx_favorites_student")
  @@index([tutor_id], map: "idx_favorites_tutor")
  @@map("favorites")
}

model MatchingLog {
  log_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String   @db.Uuid
  tutor_id          String   @db.Uuid
  match_score       Decimal? @db.Decimal(5, 2)
  algorithm_version String?
  factors_json      Json?
  is_clicked        Boolean  @default(false)
  is_booked         Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_matching_logs_student")
  @@index([tutor_id], map: "idx_matching_logs_tutor")
  @@map("matching_logs")
}

// ================================================================
// MODULE 8: DOCUMENT & AI (Tài liệu học tập & Trợ lý AI)
// ================================================================

model Document {
  doc_id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id      String    @db.Uuid
  uploaded_by    String    @db.Uuid
  file_url       String
  file_type      String
  title          String
  description    String?
  extracted_text String?
  is_indexed     Boolean   @default(false)
  indexed_at     DateTime? @db.Timestamptz
  metadata       Json?     @default("{}")
  created_at     DateTime  @default(now()) @db.Timestamptz

  // Relations
  course Course          @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  user   User            @relation(fields: [uploaded_by], references: [user_id])
  chunks DocumentChunk[]

  @@index([course_id, created_at(sort: Desc)], map: "idx_documents_course")
  @@index([uploaded_by], map: "idx_documents_uploaded_by")
  @@map("documents")
}

model DocumentChunk {
  chunk_id    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_id      String                       @db.Uuid
  content     String
  chunk_index Int
  token_count Int?
  embedding   Unsupported("vector(1536)")?
  created_at  DateTime                     @default(now()) @db.Timestamptz

  // Relations
  document Document @relation(fields: [doc_id], references: [doc_id], onDelete: Cascade)

  @@index([doc_id], map: "idx_document_chunks_doc")
  @@map("document_chunks")
}

model AIConversation {
  conversation_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  session_id      String?  @db.Uuid
  course_id       String?  @db.Uuid
  role            String
  message         String
  model_used      String?
  tokens_used     Int?
  timestamp       DateTime @default(now()) @db.Timestamptz
  created_at      DateTime @default(now()) @db.Timestamptz

  // Relations
  user    User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  session ClassSession? @relation(fields: [session_id], references: [session_id], onDelete: SetNull)
  course  Course?       @relation(fields: [course_id], references: [course_id], onDelete: SetNull)

  @@index([user_id, timestamp(sort: Desc)], map: "idx_ai_conversations_user")
  @@index([session_id], map: "idx_ai_conversations_session")
  @@map("ai_conversations")
}

// ================================================================
// MODULE 9: QUIZ (Bài kiểm tra trắc nghiệm & Tự luận)
// ================================================================

enum QuizQuestionType {
  multiple_choice // Trắc nghiệm chọn 1 đáp án
  true_false      // Đúng / Sai
  fill_in_blank   // Điền vào chỗ trống
  essay           // Tự luận
}

enum QuizStatus {
  draft     // Nháp
  published // Đã phát hành
  archived  // Lưu trữ
}

model Quiz {
  quiz_id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id          String     @db.Uuid
  title              String
  description        String?
  generated_by_ai    Boolean    @default(false)
  ai_model_version   String?
  time_limit_minutes Int?
  max_attempts       Int        @default(1)
  passing_score      Int?       @db.SmallInt
  status             QuizStatus @default(draft)
  created_at         DateTime   @default(now()) @db.Timestamptz

  // Relations
  course    Course         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([course_id, status], map: "idx_quizzes_course")
  @@map("quizzes")
}

model QuizQuestion {
  question_id    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id        String           @db.Uuid
  question_text  String
  question_type  QuizQuestionType @default(multiple_choice)
  options_json   Json?
  correct_answer String?
  explanation    String?
  points         Int              @default(1) @db.SmallInt
  order_index    Int              @default(0)
  created_at     DateTime         @default(now()) @db.Timestamptz

  // Relations
  quiz Quiz @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)

  @@index([quiz_id, order_index], map: "idx_quiz_questions_quiz")
  @@map("quiz_questions")
}

model QuizAttempt {
  attempt_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id       String    @db.Uuid
  quiz_id          String    @db.Uuid
  score            Decimal?  @db.Decimal(5, 2)
  total_points     Int?
  answers_json     Json?     @default("[]")
  started_at       DateTime  @default(now()) @db.Timestamptz
  completed_at     DateTime? @db.Timestamptz
  duration_seconds Int?
  is_passed        Boolean?
  created_at       DateTime  @default(now()) @db.Timestamptz

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  quiz    Quiz           @relation(fields: [quiz_id], references: [quiz_id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_quiz_attempts_student")
  @@index([quiz_id], map: "idx_quiz_attempts_quiz")
  @@map("quiz_attempts")
}

// ================================================================
// MODULE 10: ADMIN & SYSTEM (Quản trị hệ thống & Bảng vẽ)
// ================================================================

model AdminLog {
  log_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id     String   @db.Uuid
  action       String
  target_type  String
  target_id    String?  @db.Uuid
  details_json Json?
  ip_address   String?
  created_at   DateTime @default(now()) @db.Timestamptz

  // Relations
  admin User @relation(fields: [admin_id], references: [user_id])

  @@index([admin_id, created_at(sort: Desc)], map: "idx_admin_logs_admin")
  @@index([target_type, target_id], map: "idx_admin_logs_target")
  @@map("admin_logs")
}

model SystemConfig {
  config_key   String   @id
  config_value String?
  description  String?
  updated_at   DateTime @default(now()) @db.Timestamptz

  @@map("system_configs")
}

model WhiteboardState {
  state_id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String   @db.Uuid
  drawing_data_json Json
  timestamp         DateTime @default(now()) @db.Timestamptz
  created_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz

  // Relations
  session ClassSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  user    User         @relation(fields: [created_by], references: [user_id])

  @@index([session_id, timestamp], map: "idx_whiteboard_session")
  @@map("whiteboard_states")
}

// ================================================================
// MODULE 11: ARTICLE & COMMENT (Bài viết & Bình luận)
// ================================================================

model Article {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  excerpt       String
  content       Json
  date          String
  author        String
  commentsCount Int              @default(0)
  category      String
  imageType     String
  tags          Json
  created_at    DateTime         @default(now()) @db.Timestamptz
  comments      ArticleComment[]

  @@map("articles")
}

model ArticleComment {
  comment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  article_id String   @db.Uuid
  user_id    String   @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  // Relations
  article Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([article_id, created_at(sort: Desc)], map: "idx_article_comments_article")
  @@index([user_id], map: "idx_article_comments_user")
  @@map("article_comments")
}

model CourseComment {
  comment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id  String   @db.Uuid
  user_id    String   @db.Uuid
  content    String
  rating     Int?     @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  // Relations
  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([course_id, created_at(sort: Desc)], map: "idx_course_comments_course")
  @@index([user_id], map: "idx_course_comments_user")
  @@map("course_comments")
}
