generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, citext, pg_trgm, vector, unaccent]
}

// ================================================================
// MODULE 1: USER & AUTHENTICATION (Tài khoản người dùng & Xác thực)
// ================================================================

// Phân quyền người dùng trong hệ thống
enum UserRole {
  student // Học sinh: có thể tìm gia sư, đặt lịch, làm quiz, chat
  tutor // Gia sư: tạo khóa học, dạy học, quản lý lịch, nhận tiền
  admin // Quản trị viên: duyệt hồ sơ gia sư, quản lý hệ thống, kiểm duyệt
}

// Trạng thái tài khoản người dùng
enum UserStatus {
  active // Hoạt động bình thường
  suspended // Bị tạm khóa (khi vi phạm quy định hoặc đang chờ xác minh)
  deleted // Đã xóa tài khoản (soft delete)
}

// Vị trí / Chức vụ của Quản trị viên trong hệ thống
enum AdminPosition {
  super_admin // Quản trị viên hệ thống (Quản lý toàn bộ)
  moderator // Kiểm duyệt viên (Duyệt hồ sơ gia sư, bằng cấp, khóa học)
  customer_support // Chăm sóc & Hỗ trợ khách hàng
  content_manager // Quản lý nội dung bài viết
  financial_manager // Quản lý tài chính & xử lý rút tiền (Payouts)
}

// ================================================================
// BẢNG: users
// Mô tả: Lưu thông tin tài khoản của tất cả người dùng trong hệ thống.
//        Là bảng trung tâm liên kết với mọi module khác (Tutor, Student, Booking, Chat...).
// Quan hệ: 1 User có 1 TutorProfile HOẶC 1 StudentProfile (tùy role).
// ================================================================
model User {
  // 1. Primary Key
  user_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID

  // 2. Core Account Info
  email           String     @unique @db.Citext // Email đăng nhập
  password        String? // Mật khẩu người dùng (đã được mã hóa bcrypt)
  role            UserRole   @default(student) // Phân quyền (mặc định là học sinh khi đăng ký)
  status          UserStatus @default(active) // Trạng thái tài khoản (mặc định active)
  email_verified  Boolean    @default(false) // Trạng thái xác thực email
  social_provider String? // Nhà cung cấp đăng nhập MXH (Google, Facebook...) nếu có
  social_id       String? // ID duy nhất từ Google/Facebook trả về

  // 3. Security Tokens
  verification_token         String? // Token xác minh email
  verification_token_expires DateTime? @db.Timestamptz // Thời gian hết hạn token xác minh email (24h)
  reset_token                String? // Token đặt lại mật khẩu
  reset_token_expires        DateTime? @db.Timestamptz // Thời gian hết hạn token đặt lại mật khẩu (2h)

  // 4. Timestamps
  created_at    DateTime  @default(now()) @db.Timestamptz // Thời điểm tạo tài khoản
  updated_at    DateTime  @default(now()) @db.Timestamptz // Thời điểm cập nhật thông tin mới nhất
  last_login_at DateTime? @db.Timestamptz // Lần đăng nhập cuối cùng

  // Relations
  admin_profile   AdminProfile?
  tutor_profile   TutorProfile?
  student_profile StudentProfile?
  wallets         Wallet?
  admin_logs      AdminLog[]

  documents        Document[]
  ai_conversations AIConversation[]

  tutor_certificates TutorCertificate[]
  bookings           Booking[]
  transactions       Transaction[]
  article_comments   ArticleComment[]
  course_comments    CourseComment[]
  refresh_tokens     RefreshToken[]
  payouts_processed  Payout[] // Các yêu cầu rút tiền mà Admin này đã duyệt/xử lý
  articles           Article[] // Các bài viết do người dùng (Gia sư/Admin) này tạo

  offline_class_payments   OfflineClassPayment[] // Các khoản tiền giữ chỗ (escrow) mà user này có nghĩa vụ đóng (học phí nếu là học viên, phí nhận lớp nếu là gia sư)
  refund_tickets_requested RefundTicket[]        @relation("RefundTicketRequester") // Các yêu cầu hủy/hoàn tiền do user này gửi
  refund_tickets_processed RefundTicket[]        @relation("RefundTicketProcessor") // Các yêu cầu hủy/hoàn tiền mà Admin này đã duyệt/từ chối

  @@index([role, status], map: "idx_users_role_status")
  @@index([social_provider, social_id], map: "idx_users_social")
  @@map("users")
}

// ================================================================
// BẢNG: admin_profiles
// Mô tả: Lưu thông tin cá nhân của Quản trị viên (Admin).
// Quan hệ: 1-1 với users (user_id @unique).
// ================================================================
model AdminProfile {
  // 1. Primary Key & Foreign Keys
  admin_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID
  user_id  String @unique @db.Uuid // Khóa ngoại liên kết 1-1 với users.user_id

  // 2. Personal Information
  full_name     String // Họ và tên đầy đủ
  phone         String? // Số điện thoại liên hệ
  avatar_url    String? // Đường dẫn ảnh đại diện
  date_of_birth DateTime?      @db.Date // Ngày tháng năm sinh
  gender        String? // Giới tính ("male" | "female" | "other")
  cccd          String? // Căn cước công dân
  position      AdminPosition? // Vị trí / Chức vụ nhân viên Quản trị viên

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo hồ sơ
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật thông tin mới nhất

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ================================================================
// BẢNG: refresh_tokens
// Mô tả: Lưu trữ Refresh Token của người dùng phục vụ gia hạn phiên đăng nhập JWT
// ================================================================
model RefreshToken {
  // 1. Primary Key & Foreign Keys
  token_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id  String @db.Uuid

  // 2. Token Content & Expiry
  token      String   @unique
  expires_at DateTime @db.Timestamptz

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

// ================================================================
// MODULE 2: TUTOR & STUDENT PROFILE (Hồ sơ Gia sư & Học sinh)
// ================================================================

// Hình thức giảng dạy của gia sư / học sinh ưu tiên
enum TeachingMode {
  online // Dạy online (qua video call, whiteboard)
  offline // Dạy trực tiếp tại nhà/trung tâm
  both // Linh hoạt cả 2 hình thức
}

// Trạng thái xét duyệt hồ sơ / bằng cấp bởi Admin
enum VerificationStatus {
  pending // Đang chờ Admin xem xét và duyệt
  approved // Đã được duyệt, hợp lệ
  rejected // Bị từ chối (Admin ghi lý do ở admin_note)
}

// Ngày trong tuần gia sư có thể dạy
enum DayOfWeek {
  mon // Thứ 2
  tue // Thứ 3
  wed // Thứ 4
  thu // Thứ 5
  fri // Thứ 6
  sat // Thứ 7
  sun // Chủ Nhật
}

// Buổi học trong ngày
enum TimeSlot {
  morning // Buổi Sáng
  afternoon // Buổi Chiều
  evening // Buổi Tối
}

// ================================================================
// BẢNG: tutor_profiles
// Mô tả: Hồ sơ chuyên nghiệp của Gia sư. Tách riêng khỏi bảng users 
//        để tối ưu hóa và chỉ áp dụng cho người dùng có role = tutor.
// Quan hệ: 1-1 với users (user_id @unique). 1 Tutor có nhiều Certificate, Course, Payout...
// ================================================================
model TutorProfile {
  // 1. Primary Key & Foreign Keys
  tutor_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID riêng cho hồ sơ gia sư
  user_id  String @unique @db.Uuid // Khóa ngoại liên kết 1-1 với users.user_id

  // 2. Personal Identification
  tutor_code    String?   @unique // Mã số gia sư cấp tự động (VD: GS7650)
  full_name     String    @default("") // Họ và tên đầy đủ
  phone         String? // Số điện thoại liên hệ
  avatar_url    String? // Đường dẫn ảnh đại diện / ảnh thẻ
  date_of_birth DateTime? @db.Date // Ngày tháng năm sinh
  gender        String? // Giới tính ("male" | "female" | "other")

  // 3. Educational & Experience Background
  hometown               String? // Nguyên quán (Tỉnh / Thành)
  current_address        String? // Địa chỉ hiện tại (Số nhà, đường, phường, quận...)
  id_card_front_url      String? // Đường dẫn ảnh CCCD mặt trước
  university             String? // Trường đại học / cao đẳng đang học hoặc đã tốt nghiệp
  major                  String? // Ngành học (VD: Sư phạm Toán)
  graduation_year        Int? // Năm tốt nghiệp (VD: 2024)
  current_role           String? // Hiện là (Sinh viên, Giáo viên, Cử nhân, Kỹ sư...)
  min_salary_requirement String? // Yêu cầu lương tối thiểu
  experience_years       Int?    @default(0) @db.SmallInt // Số năm kinh nghiệm dạy học

  // 4. Status, Rating & Settings
  rating          Decimal?           @default(0) @db.Decimal(2, 1) // Điểm đánh giá trung bình
  review_count    Int                @default(0) // Tổng số lượng đánh giá nhận được
  teaching_mode   TeachingMode       @default(both) // Hình thức dạy (online/offline/both)
  verified_status VerificationStatus @default(pending) // Trạng thái phê duyệt hồ sơ gia sư từ Admin
  is_featured     Boolean            @default(false) // Đánh dấu gia sư nổi bật

  // 5. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo hồ sơ
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật hồ sơ gần nhất

  // Relations
  user            User                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  certificates    TutorCertificate[]
  grade_levels    GradeLevel[] // Danh sách các khối lớp gia sư nhận dạy (Lớp 1 - 12)
  available_times TutorAvailableTime[] // Bảng quan hệ danh sách lịch rảnh dạy gia sư chọn
  courses         Course[]
  payouts         Payout[]
  reviews         Review[]
  favorites       Favorite[]
  matching_logs   MatchingLog[]

  offline_classes OfflineClass[]
  applications    ClassApplication[]

  @@index([verified_status, rating(sort: Desc)], map: "idx_tutor_profiles_verified")
  @@map("tutor_profiles")
}

// Danh mục khối lớp cố định từ Lớp 1 đến Lớp 12
enum GradeLevel {
  grade_1 // Lớp 1
  grade_2 // Lớp 2
  grade_3 // Lớp 3
  grade_4 // Lớp 4
  grade_5 // Lớp 5
  grade_6 // Lớp 6
  grade_7 // Lớp 7
  grade_8 // Lớp 8
  grade_9 // Lớp 9
  grade_10 // Lớp 10
  grade_11 // Lớp 11
  grade_12 // Lớp 12
}

// ================================================================
// BẢNG: tutor_available_times
// Mô tả: Lưu từng ô checkbox khung giờ gia sư có thể dạy (7 ngày x 3 buổi = tối đa 21 rows/tutor).
//        Mỗi row = 1 ô checkbox được chọn trong UI lịch rảnh.
// ================================================================
model TutorAvailableTime {
  // 1. Primary Key & Foreign Keys
  time_id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutor_id String @db.Uuid

  // 2. Attributes
  day_of_week DayOfWeek // Ngày trong tuần (mon, tue, ..., sun)
  time_slot   TimeSlot // Buổi học (morning, afternoon, evening)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz

  tutor TutorProfile @relation(fields: [tutor_id], references: [tutor_id], onDelete: Cascade)

  @@unique([tutor_id, day_of_week, time_slot], map: "uq_tutor_available_times") // Tránh chọn trùng khung giờ
  @@index([tutor_id], map: "idx_tutor_available_times_tutor")
  @@index([day_of_week, time_slot], map: "idx_tutor_available_times_slot") // Tìm gia sư theo khung giờ
  @@map("tutor_available_times")
}

// ================================================================
// BẢNG: student_profiles
// Mô tả: Hồ sơ thông tin học tập của Học sinh. Dùng làm dữ liệu đầu vào
//        cho thuật toán AI Matching để gợi ý Gia sư phù hợp.
// Quan hệ: 1-1 với users (user_id @unique).
// ================================================================
model StudentProfile {
  // 1. Primary Key & Foreign Keys
  student_id  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID riêng cho hồ sơ học sinh
  user_id     String      @unique @db.Uuid // Khóa ngoại liên kết 1-1 với users.user_id
  grade_level GradeLevel? // Khối lớp học của học sinh (Lớp 1 - 12)

  // 2. Personal Information & Academic Level
  full_name      String    @default("") // Họ và tên đầy đủ
  phone          String? // Số điện thoại liên hệ
  avatar_url     String? // Đường dẫn ảnh đại diện
  date_of_birth  DateTime? @db.Date // Ngày tháng năm sinh
  gender         String? // Giới tính ("male" | "female" | "other")
  address_detail String? // Địa chỉ chi tiết (Số nhà, đường...)
  province       String? // Tỉnh / Thành phố
  district       String? // Quận / Huyện
  academic_level String? // Học lực hiện tại ("Giỏi", "Khá", "Trung bình")

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo hồ sơ
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật gần nhất

  // Relations
  user          User          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  quiz_attempts QuizAttempt[]
  matching_logs MatchingLog[]

  class_requests  ClassRequest[]
  offline_classes OfflineClass[]

  @@map("student_profiles")
}

// ================================================================
// BẢNG: tutor_certificates
// Mô tả: Quản lý bằng cấp, chứng chỉ chuyên môn của gia sư upload lên.
// Luồng hoạt động: Upload -> pending -> Admin duyệt (approved/rejected kèm admin_note).
// ================================================================
model TutorCertificate {
  // 1. Primary Key & Foreign Keys
  cert_id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho chứng chỉ
  tutor_id          String  @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id
  verified_by_admin String? @db.Uuid // FK tới users.user_id - Ghi nhận Admin nào đã duyệt bằng này

  // 2. Certificate Details
  title       String // Tên bằng cấp / chứng chỉ (VD: Bằng Thạc sĩ Sư Phạm, IELTS 8.0)
  file_url    String // Đường dẫn lưu file scan bằng cấp (lưu trên CDN/Cloud)
  file_type   String? // Định dạng file (PDF, PNG, JPG)
  issued_by   String? // Nơi cấp (VD: Đại học Quốc Gia, British Council)
  issued_date DateTime?          @db.Date // Ngày cấp bằng (chỉ lưu ngày)
  expiry_date DateTime?          @db.Date // Ngày hết hạn chứng chỉ (nếu có, VD: IELTS hết hạn sau 2 năm)
  status      VerificationStatus @default(pending) // Trạng thái xét duyệt (pending, approved, rejected)
  admin_note  String? // Ghi chú của Admin (bắt buộc điền lý do khi từ chối/rejected)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Ngày upload
  updated_at DateTime @default(now()) @db.Timestamptz // Ngày cập nhật trạng thái duyệt

  // Relations
  tutor TutorProfile @relation(fields: [tutor_id], references: [tutor_id], onDelete: Cascade)
  admin User?        @relation(fields: [verified_by_admin], references: [user_id], onDelete: SetNull)

  @@index([tutor_id], map: "idx_certificates_tutor")
  @@index([status], map: "idx_certificates_status")
  @@map("tutor_certificates")
}

// ================================================================
// MODULE 3: COURSE & SCHEDULE (Khóa học & Lịch giảng dạy)
// ================================================================

// Phân loại hình thức khóa học số (dạy trực tiếp đã được tách riêng sang module class_requests)
enum CourseType {
  online // Lớp học trực tuyến Live với Gia sư theo lịch đặt trước (1-1 hoặc nhóm)
  offline // Dạy trực tiếp tại nhà/trung tâm
  video // Khóa học Video pre-recorded tự học theo tốc độ cá nhân
}

// Trạng thái hiển thị / phát hành của khóa học
enum CourseStatus {
  draft // Bản nháp: Gia sư đang tạo, chưa mở đăng ký cho học sinh thấy
  published // Đã đăng: Hiển thị trên danh sách tìm kiếm, học sinh có thể đặt lịch
  hidden // Tạm ẩn: Không xuất hiện ở tìm kiếm (VD: Gia sư tạm ngừng nhận thêm lớp)
  archived // Lưu trữ: Khóa học đã kết thúc hẳn, dùng để lưu lịch sử
}

// ================================================================
// BẢNG: subjects
// Mô tả: Quản lý danh mục Môn học chuẩn hóa trong hệ thống (Do Admin quản lý).
// Quan hệ: 1 Subject có nhiều Course.
// ================================================================
model Subject {
  // 1. Primary Key
  subject_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho môn học

  // 2. Attributes
  name      String  @unique // Tên môn học (VD: "Toán học", "Vật lý", "Tiếng Anh")
  code      String? @unique // Mã môn học (VD: "MATH", "PHYS", "ENG")
  is_active Boolean @default(true) // Trạng thái kích hoạt (true: đang hoạt động, false: ẩn)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo môn học
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật môn học gần nhất

  courses        Course[]
  class_requests ClassRequest[]

  @@map("subjects")
}

// ================================================================
// BẢNG: courses
// Mô tả: Quản lý thông tin các khóa học do Gia sư tạo ra.
// Luồng: Gia sư tạo draft -> chọn loại (online: lớp live | video: khóa video) -> thêm lịch học hoặc upload video -> published.
// ================================================================
model Course {
  // 1. Primary Key & Foreign Keys
  course_id  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho khóa học
  tutor_id   String  @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id (Xóa tutor -> xóa khóa học)
  subject_id String? @db.Uuid // Khóa ngoại liên kết tới subjects.subject_id

  // 2. Course Details
  title         String // Tên khóa học (VD: "Toán 12 luyện thi THPT Quốc Gia")
  description   String? // Mô tả nội dung, mục tiêu kiến thức & phương pháp giảng dạy
  level         String? // Trình độ yêu cầu (VD: "Cơ bản", "Nâng cao", "Luyện thi 9+")
  type          CourseType   @default(online) // Loại khóa học (online: live trực tuyến theo lịch, video: video pre-recorded tự học)
  status        CourseStatus @default(draft) // Trạng thái khóa học (draft, published, hidden, archived)
  thumbnail_url String? // Đường dẫn ảnh đại diện khóa học (hiển thị trên trang danh sách/tìm kiếm)

  // 3. Schedule & Pricing Parameters
  price            Decimal   @db.Decimal(10, 2) // Học phí trọn gói khóa học (dùng Decimal tránh sai số tiền tệ)
  start_date       DateTime? @db.Date // Ngày bắt đầu / khai giảng khóa Online
  schedule_time    String? // Giờ bắt đầu mỗi buổi học (VD: "07:00", "19:30") — kết hợp với course_days để generate lịch
  duration_minutes Int       @default(60) @db.SmallInt // Thời lượng mỗi buổi học tính bằng phút (VD: 60, 90, 120)
  max_students     Int       @default(1) @db.SmallInt // Số học sinh tối đa trong 1 lớp (1 = dạy 1-1, >1 = dạy nhóm)
  total_sessions   Int       @default(1) @db.SmallInt // Tổng số buổi học trong toàn bộ khóa (VD: 10 buổi, 20 buổi)

  // 4. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo khóa học
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật thông tin gần nhất

  // Relations
  tutor            TutorProfile     @relation(fields: [tutor_id], references: [tutor_id], onDelete: Cascade)
  subject_relation Subject?         @relation(fields: [subject_id], references: [subject_id], onDelete: SetNull)
  course_days      CourseDay[] // Các ngày học trong tuần (many-to-many với DayOfWeek enum)
  schedules        CourseSchedule[]
  lessons          CourseLesson[]
  bookings         Booking[]
  documents        Document[]
  ai_conversations AIConversation[]
  quizzes          Quiz[]
  comments         CourseComment[]

  @@index([tutor_id, status], map: "idx_courses_tutor")
  @@index([subject_id, status], map: "idx_courses_subject")
  @@index([type, status], map: "idx_courses_type_status")
  @@index([status, created_at(sort: Desc)], map: "idx_courses_status")
  @@map("courses")
}

// Trạng thái của từng buổi học trong khóa online
enum SessionStatus {
  upcoming // Buổi học chưa diễn ra
  completed // Gia sư đã dạy xong buổi này
  cancelled // Buổi bị hủy (gia sư xin hoãn hoặc sự cố)
}

// ================================================================
// BẢNG: course_days
// Mô tả: Bảng junction lưu các ngày trong tuần gia sư dạy khóa học này.
//        Tái sử dụng enum DayOfWeek. Backend dùng bảng này để generate lịch học.
// VD: Khóa T2-T4-T6 → 3 rows: (course_id, mon), (course_id, wed), (course_id, fri)
// ================================================================
model CourseDay {
  // 1. Primary Key & Foreign Keys
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id String @db.Uuid // FK → courses.course_id

  // 2. Day of Week
  day_of_week DayOfWeek // Ngày học trong tuần (mon, tue, wed, thu, fri, sat, sun)

  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@unique([course_id, day_of_week], map: "uq_course_days") // 1 khóa không lặp ngày
  @@index([course_id], map: "idx_course_days_course")
  @@map("course_days")
}

// ================================================================
// BẢNG: course_lessons
// Mô tả: Quản lý danh sách bài giảng Video cho khóa học loại `video` (pre-recorded).
// Quan hệ: Liên kết 1-N với courses (course_id).
// ================================================================
model CourseLesson {
  // 1. Primary Key & Foreign Keys
  lesson_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bài học
  course_id String @db.Uuid // Khóa ngoại liên kết tới courses.course_id

  // 2. Lesson Details
  title       String // Tên tiêu đề bài giảng / bài học
  description String? // Mô tả ngắn gọn nội dung bài học
  video_url   String // Đường dẫn xem Video bài giảng (lưu trên Cloud Storage / CDN)
  order_index Int     @default(1) // Thứ tự sắp xếp bài học trong khóa (1, 2, 3...)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo bài học
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật bài học gần nhất

  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@index([course_id, order_index], map: "idx_lessons_course_order")
  @@map("course_lessons")
}

// ================================================================
// BẢNG: course_schedules
// Mô tả: Từng buổi học cụ thể của khóa Online được backend tự động generate.
//        1 row = 1 buổi học (session_number từ 1 → total_sessions).
//        Khóa kết thúc khi tất cả buổi đều completed.
// ================================================================
model CourseSchedule {
  // 1. Primary Key & Foreign Keys
  schedule_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho buổi học
  course_id   String @db.Uuid // Khóa ngoại liên kết tới courses.course_id

  // 2. Schedule Details & Slots
  session_number Int           @default(0) @db.SmallInt // Thứ tự buổi học trong khóa (1, 2, ..., total_sessions)
  start_time     DateTime      @db.Timestamptz // Thời điểm bắt đầu buổi học (có kèm múi giờ)
  end_time       DateTime      @db.Timestamptz // Thời điểm kết thúc buổi học (có kèm múi giờ)
  booked_count   Int           @default(0) @db.SmallInt // Số học sinh đã đặt buổi này (tăng khi có Booking confirmed)
  max_slot       Int           @default(1) @db.SmallInt // Số chỗ tối đa (= max_students của Course)
  status         SessionStatus @default(upcoming) // Trạng thái buổi học

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo buổi học

  // Relations
  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@index([course_id, session_number], map: "uq_course_session_number") // Thứ tự buổi trong khóa (app đảm bảo không trùng)
  @@index([course_id, start_time], map: "idx_schedules_course")
  @@index([start_time, status], map: "idx_schedules_upcoming") // Tìm buổi sắp tới
  @@map("course_schedules")
}

// ================================================================
// MODULE 4: BOOKING & PAYMENT (Đặt lịch & Thanh toán)
// ================================================================

// Phương thức thanh toán
enum PaymentMethod {
  zalopay // Thanh toán qua cổng ZaloPay
  wallet // Thanh toán bằng Ví nội bộ hệ thống
  mock // Thanh toán giả lập (dùng cho dev/demo)
}

// Trạng thái của Booking (tiến độ tổng thể đặt lịch)
enum BookingStatus {
  pending // Chờ xác nhận: Vừa đặt, đang chờ gia sư xác nhận hoặc chờ học sinh hoàn tất thanh toán
  confirmed // Đã xác nhận: Học sinh đã thanh toán thành công, lịch học chính thức được duyệt
  completed // Đã hoàn thành: Tất cả các buổi học trong khóa đã dạy xong
  cancelled // Đã hủy: Lịch đặt bị hủy bởi học sinh hoặc gia sư
  refunded // Đã hoàn tiền: Booking bị hủy hợp lệ và tiền đã được trả lại cho học sinh
}

// Trạng thái thanh toán của Booking
enum PaymentStatus {
  unpaid // Chưa thanh toán: Khởi tạo ban đầu khi vừa bấm đặt lịch
  paid // Đã thanh toán: Học sinh đã chuyển tiền thành công qua ZaloPay/Ví
  refunded // Đã hoàn tiền: Đã thực hiện refund lại cho học sinh
  failed // Thanh toán thất bại: Do lỗi thẻ, hết hạn giao dịch hoặc lỗi cổng thanh toán
}

// Trạng thái của từng lần giao dịch thanh toán qua cổng (ZaloPay)
enum TransactionStatus {
  pending // Đang xử lý: Đã tạo đơn trên ZaloPay, đang chờ callback kết quả
  success // Thành công: ZaloPay xác nhận tiền đã vào tài khoản hệ thống
  failed // Thất bại: Giao dịch bị lỗi, hủy hoặc quá thời hạn thanh toán
  refunded // Hoàn tiền: Giao dịch thanh toán này đã được thực hiện hoàn lại
}

// Trạng thái yêu cầu rút tiền của Gia sư
enum PayoutStatus {
  pending // Chờ xử lý: Gia sư gửi yêu cầu rút tiền, Admin chưa duyệt
  processing // Đang chuyển khoản: Admin đã duyệt và đang thực hiện giao dịch ngân hàng
  completed // Thành công: Tiền đã được chuyển thành công vào tài khoản ngân hàng gia sư
  failed // Thất bại: Rút tiền không thành công (VD: Sai số tài khoản ngân hàng)
}

// ================================================================
// BẢNG: bookings
// Mô tả: Bảng trung tâm quản lý việc đặt lịch học của Học sinh với Khóa học/Lịch học.
// Luồng: Học sinh chọn lịch -> Tạo Booking (pending) -> Thanh toán -> confirmed -> Hoàn thành.
// Quan hệ: Liên kết StudentProfile, Course, CourseSchedule. Có quan hệ 1-N với Transaction, ClassSession.
// ================================================================
model Booking {
  // 1. Primary Key & Foreign Keys
  booking_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID riêng cho đơn đặt lịch
  student_id   String  @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id
  course_id    String  @db.Uuid // Khóa ngoại liên kết tới courses.course_id
  cancelled_by String? @db.Uuid // FK tới users.user_id - Ghi nhận ai là người bấm hủy (học sinh hay gia sư)

  // 2. Booking Status & Notes
  status           BookingStatus @default(pending) // Trạng thái tiến độ booking (pending -> confirmed -> completed)
  payment_status   PaymentStatus @default(unpaid) // Trạng thái thanh toán tiền (unpaid -> paid)
  notes            String? // Ghi chú của học sinh khi đặt lịch (yêu cầu riêng)
  cancelled_reason String? // Lý do hủy booking (bắt buộc khi trạng thái = cancelled)

  // 3. Financial Amount
  total_amount Decimal @db.Decimal(10, 2) // Tổng tiền học phí cần thanh toán (VND)
  platform_fee Decimal @default(0) @db.Decimal(10, 2) // Tiền hoa hồng hệ thống thu (VD: 10% của total_amount)
  currency     String  @default("VND") // Đơn vị tiền tệ (mặc định VND)

  // 4. Timestamps
  cancelled_at DateTime? @db.Timestamptz // Thời điểm thực hiện hủy booking
  created_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm tạo đơn đặt lịch
  updated_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm cập nhật trạng thái mới nhất

  // Relations
  student         StudentProfile @relation(fields: [student_id], references: [student_id])
  course          Course         @relation(fields: [course_id], references: [course_id])
  cancelledByUser User?          @relation(fields: [cancelled_by], references: [user_id], onDelete: SetNull)

  transactions Transaction[]
  reviews      Review?

  @@index([student_id, status, created_at(sort: Desc)], map: "idx_bookings_student")
  @@index([course_id], map: "idx_bookings_course")
  @@map("bookings")
}

// ================================================================
// BẢNG: transactions
// Mô tả: Lưu lịch sử từng lần giao dịch thanh toán qua cổng thanh toán ZaloPay.
// Lý do tách riêng: 1 Booking có thể thử thanh toán nhiều lần nếu lần đầu bị lỗi.
// ================================================================
model Transaction {
  // 1. Primary Key & Foreign Keys
  transaction_id String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho giao dịch
  booking_id     String? @db.Uuid // Khóa ngoại liên kết tới bookings.booking_id (nullable: giao dịch nội bộ không có booking)
  user_id        String  @db.Uuid // Khóa ngoại liên kết tới users.user_id (người thực hiện thanh toán)

  // 2. Transaction Details & Amount
  amount         Decimal           @db.Decimal(10, 2) // Số tiền thanh toán thực tế (VND)
  payment_method PaymentMethod     @default(zalopay) // Phương thức thanh toán (zalopay | wallet)
  description    String? // Mô tả giao dịch (VD: "Phí nhận lớp MS:89513", "Nạp tiền thủ công", "Học phí Toán 12")
  status         TransactionStatus @default(pending) // Trạng thái giao dịch (pending -> success / failed)

  // 3. Payment Gateway Callback Data
  zalopay_order_id      String? // AppTransID do hệ thống gửi sang ZaloPay để tạo đơn
  zalopay_trans_id      String? // Mã giao dịch chính thức do ZaloPay trả về sau khi thanh toán xong
  zalopay_callback_data Json? // Mảng JSON lưu nguyên bản dữ liệu callback từ ZaloPay (phục vụ đối soát/audit)

  // 4. Timestamps
  paid_at    DateTime? @db.Timestamptz // Thời điểm xác nhận giao dịch thành công
  created_at DateTime  @default(now()) @db.Timestamptz // Thời điểm tạo giao dịch
  updated_at DateTime  @default(now()) @db.Timestamptz // Thời điểm cập nhật trạng thái

  // Relations
  booking Booking? @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  user    User     @relation(fields: [user_id], references: [user_id])

  offline_class_payment OfflineClassPayment? // Khoản tiền giữ chỗ (escrow) mà giao dịch này thực hiện thanh toán, nếu có (quan hệ 1-1 ngược từ OfflineClassPayment.transaction_id)

  @@index([booking_id], map: "idx_transactions_booking")
  @@index([user_id, created_at(sort: Desc)], map: "idx_transactions_user")
  @@map("transactions")
}

// ================================================================
// BẢNG: wallets
// Mô tả: Ví tiền điện tử nội bộ của mỗi người dùng (đặc biệt là Gia sư).
// Luồng: Học sinh thanh toán -> Tiền sau khi trừ phí hoa hồng được cộng vào ví Gia sư -> Gia sư rút tiền.
// ================================================================
model Wallet {
  // 1. Primary Key & Foreign Keys
  wallet_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID của ví
  user_id   String @unique @db.Uuid // Khóa ngoại 1-1 với users.user_id (mỗi user chỉ có 1 ví duy nhất)

  // 2. Balance & Currency
  balance        Decimal @default(0) @db.Decimal(10, 2) // Số dư khả dụng hiện tại (VND) = tổng tiền - frozen_balance
  frozen_balance Decimal @default(0) @db.Decimal(10, 2) // Số dư đang bị hold bởi Payout đang xử lý (pending/processing)
  currency       String  @default("VND") // Đơn vị tiền tệ

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm khởi tạo ví
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm biến động số dư gần nhất

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("wallets")
}

// ================================================================
// BẢNG: payouts
// Mô tả: Quản lý các yêu cầu rút tiền của Gia sư từ Ví nội bộ về Tài khoản Ngân hàng thực tế.
// Luồng: Gia sư tạo Payout request -> Admin kiểm tra & duyệt -> Chuyển khoản -> completed.
// ================================================================
model Payout {
  // 1. Primary Key & Foreign Keys
  payout_id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID của đợt rút tiền
  tutor_id     String  @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id
  processed_by String? @db.Uuid // FK tới users.user_id - Admin nào đã duyệt/xử lý yêu cầu này

  // 2. Amount & Bank Details
  amount              Decimal      @db.Decimal(10, 2) // Số tiền gia sư yêu cầu rút (VND)
  bank_account        String? // Số tài khoản ngân hàng nhận tiền
  bank_name           String? // Tên ngân hàng (VD: Vietcombank, MBBank, Techcombank)
  account_holder_name String? // Tên chủ tài khoản ngân hàng (bắt buộc khi chuyển khoản)
  status              PayoutStatus @default(pending) // Trạng thái rút tiền (pending -> processing -> completed)
  admin_note          String? // Ghi chú của Admin khi xử lý (bắt buộc khi failed)

  // 3. Settlement Period & Timestamps
  period_start DateTime? @db.Date // Ngày bắt đầu kỳ đối soát doanh thu
  period_end   DateTime? @db.Date // Ngày kết thúc kỳ đối soát doanh thu
  processed_at DateTime? @db.Timestamptz // Thời điểm Admin bấm duyệt hoàn tất chuyển khoản
  created_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm gửi yêu cầu rút tiền

  // Relations
  tutor           TutorProfile @relation(fields: [tutor_id], references: [tutor_id])
  processed_admin User?        @relation(fields: [processed_by], references: [user_id], onDelete: SetNull)

  @@index([tutor_id, created_at(sort: Desc)], map: "idx_payouts_tutor")
  @@index([status], map: "idx_payouts_status")
  @@map("payouts")
}

// ================================================================
// MODULE 7: REVIEW, FAVORITE & MATCHING (Đánh giá, Yêu thích & Gợi ý)
// ================================================================

// ================================================================
// BẢNG: reviews
// Mô tả: Lưu trữ bài đánh giá chất lượng gia sư từ học sinh sau khi học xong.
// Ràng buộc: booking_id @unique đảm bảo 1 đơn đặt lịch chỉ được viết 1 bài review (tránh spam).
// ================================================================
model Review {
  // 1. Primary Key & Foreign Keys
  review_id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho đánh giá
  booking_id String @unique @db.Uuid // Khóa ngoại 1-1 với bookings.booking_id (chống đánh giá trùng lập)
  student_id String @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id (người viết review)
  tutor_id   String @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id (gia sư nhận review)

  // 2. Ratings & Comment
  rating          Int     @db.SmallInt // Điểm số đánh giá tổng thể (thang điểm 1 -> 5 sao)
  professionalism Int?    @db.SmallInt // Điểm tiêu chí: Trình độ chuyên môn & Phương pháp giảng dạy (1-5 sao)
  communication   Int?    @db.SmallInt // Điểm tiêu chí: Khả năng giao tiếp & Truyền đạt kiến thức (1-5 sao)
  punctuality     Int?    @db.SmallInt // Điểm tiêu chí: Sự đúng giờ & Tác phong làm việc (1-5 sao)
  comment         String? // Nội dung nhận xét bằng văn bản của học sinh
  is_visible      Boolean @default(true) // Trạng thái hiển thị (true = công khai, false = tạm ẩn do vi phạm quy chuẩn)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo đánh giá
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm chỉnh sửa đánh giá

  // Relations
  booking Booking        @relation(fields: [booking_id], references: [booking_id])
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@index([tutor_id, created_at(sort: Desc)], map: "idx_reviews_tutor")
  @@index([student_id], map: "idx_reviews_student")
  @@map("reviews")
}

// ================================================================
// BẢNG: favorites
// Mô tả: Danh sách gia sư yêu thích (Wishlist/Bookmark) của học sinh.
// Ràng buộc: @@unique([student_id, tutor_id]) đảm bảo học sinh không thể lưu 1 gia sư 2 lần.
// ================================================================
model Favorite {
  // 1. Primary Key & Foreign Keys
  favorite_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho mục yêu thích
  student_id  String @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id
  tutor_id    String @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id

  // 2. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm bấm lưu gia sư yêu thích

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@unique([student_id, tutor_id])
  @@index([student_id], map: "idx_favorites_student")
  @@index([tutor_id], map: "idx_favorites_tutor")
  @@map("favorites")
}

// ================================================================
// BẢNG: matching_logs
// Mô tả: Nhật ký kết quả gợi ý Gia sư cho Học sinh do Thuật toán AI Matching thực hiện.
// Mục đích: Đánh giá độ chính xác của thuật toán AI (Machine Learning CTR/Conversion Rate).
// ================================================================
model MatchingLog {
  // 1. Primary Key & Foreign Keys
  log_id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bản ghi log AI
  student_id String @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id (người nhận gợi ý)
  tutor_id   String @db.Uuid // Khóa ngoại liên kết tới tutor_profiles.tutor_id (gia sư được AI đề xuất)

  // 2. Recommendation Metadata & Interaction Flags
  match_score       Decimal? @db.Decimal(5, 2) // Điểm độ phù hợp tính bằng % do AI tính (VD: 95.50%)
  algorithm_version String? // Phiên bản thuật toán AI Matching (VD: "v1.0-content-based", "v2.0-hybrid")
  factors_json      Json? // Mảng JSON lưu chi tiết trọng số lý do ghép cặp (VD: {"subject_match": 1.0, "budget_match": 0.85})
  is_clicked        Boolean  @default(false) // Cờ ghi nhận học sinh có bấm vào xem hồ sơ gia sư này không
  is_booked         Boolean  @default(false) // Cờ ghi nhận học sinh có thực hiện đặt lịch sau gợi ý không

  // 3. Timestamps
  clicked_at DateTime? @db.Timestamptz // Thời điểm học sinh bấm vào xem hồ sơ (null nếu chưa click)
  booked_at  DateTime? @db.Timestamptz // Thời điểm học sinh đặt lịch sau gợi ý (null nếu chưa book)
  created_at DateTime  @default(now()) @db.Timestamptz // Thời điểm AI đưa ra gợi ý

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  tutor   TutorProfile   @relation(fields: [tutor_id], references: [tutor_id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_matching_logs_student")
  @@index([tutor_id], map: "idx_matching_logs_tutor")
  @@map("matching_logs")
}

// ================================================================
// MODULE 8: DOCUMENT & AI (Tài liệu học tập & Trợ lý AI)
// ================================================================

// ================================================================
// BẢNG: documents
// Mô tả: Quản lý tài liệu học tập (PDF, DOCX, Slide...) do Gia sư upload lên cho khóa học.
// Mục đích: Làm dữ liệu đầu vào cho tính năng Trợ lý AI Hỏi đáp theo tài liệu (RAG - Retrieval-Augmented Generation).
// ================================================================
model Document {
  // 1. Primary Key & Foreign Keys
  doc_id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho tài liệu
  course_id   String @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa tài liệu)
  uploaded_by String @db.Uuid // Khóa ngoại liên kết tới users.user_id (người tải tài liệu lên)

  // 2. Document Content & Storage
  title          String // Tên tiêu đề của tài liệu (VD: "Giáo trình Giải tích 12 - Chương 1")
  description    String? // Tóm tắt ngắn gọn mô tả nội dung tài liệu
  file_url       String // Đường dẫn lưu file đính kèm thực tế trên Cloud Storage
  file_type      String // Phân loại định dạng tệp tin ("pdf", "docx", "pptx", "txt"...)
  extracted_text String? // Nội dung văn bản thô bóc tách từ file PDF/DOCX (dùng cho thuật toán RAG)
  metadata       Json?   @default("{}") // Mảng JSON chứa thông tin phụ (VD: {"page_count": 45, "author": "Nguyễn Văn A"})
  is_indexed     Boolean @default(false) // Trạng thái đã cắt chunk và vector hóa xong chưa (false = chưa, true = sẵn sàng RAG)

  // 3. Timestamps
  indexed_at DateTime? @db.Timestamptz // Thời điểm hoàn tất đánh chỉ mục vector
  created_at DateTime  @default(now()) @db.Timestamptz // Thời điểm upload tài liệu

  // Relations
  course Course          @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  user   User            @relation(fields: [uploaded_by], references: [user_id])
  chunks DocumentChunk[]

  @@index([course_id, created_at(sort: Desc)], map: "idx_documents_course")
  @@index([uploaded_by], map: "idx_documents_uploaded_by")
  @@map("documents")
}

// ================================================================
// BẢNG: document_chunks
// Mô tả: Lưu trữ các đoạn văn bản nhỏ (Chunks) được chia từ tài liệu gốc cùng vector nhúng (Embedding).
// Điểm nổi bật: Sử dụng kiểu dữ liệu Unsupported("vector(1536)") của pgvector (PostgreSQL) để thực hiện Similarity Search.
// ================================================================
model DocumentChunk {
  // 1. Primary Key & Foreign Keys
  chunk_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho đoạn chunk
  doc_id   String @db.Uuid // Khóa ngoại liên kết tới documents.doc_id (Xóa tài liệu gốc -> xóa các chunk)

  // 2. Chunk Data & Vector Embedding
  content     String // Nội dung văn bản của đoạn chunk đã được cắt nhỏ
  chunk_index Int // Thứ tự của đoạn chunk trong tài liệu gốc (0, 1, 2...)
  token_count Int? // Số lượng token tương ứng với đoạn chunk này
  embedding   Unsupported("vector(1536)")? // Vector nhúng 1536 chiều sinh từ OpenAI/Gemini Embedding API (pgvector)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo chunk

  // Relations
  document Document @relation(fields: [doc_id], references: [doc_id], onDelete: Cascade)

  @@index([doc_id], map: "idx_document_chunks_doc")
  @@map("document_chunks")
}

// ================================================================
// BẢNG: ai_conversations
// Mô tả: Lưu trữ lịch sử hỏi đáp giữa Học sinh / Gia sư với Trợ lý AI (AI Tutor Assistant).
// Quan hệ: Có thể gắn với 1 buổi học cụ thể (session_id) hoặc 1 khóa học (course_id) để khoanh vùng bối cảnh (Context Scope).
// ================================================================
model AIConversation {
  // 1. Primary Key & Foreign Keys
  conversation_id String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bản ghi tin nhắn AI
  user_id         String  @db.Uuid // Khóa ngoại liên kết tới users.user_id (người thực hiện hỏi AI)
  course_id       String? @db.Uuid // FK tới courses.course_id - Nếu hỏi AI trong phạm vi khóa học

  // 2. Message Content & AI Parameters
  role        String // Vai trò người gửi ("user" = câu hỏi học sinh, "assistant" = câu trả lời AI, "system" = prompt hệ thống)
  message     String // Nội dung văn bản của câu hỏi hoặc câu trả lời AI
  model_used  String? // Tên mô hình AI được sử dụng (VD: "gpt-4o", "gemini-1.5-pro")
  tokens_used Int? // Tổng số token tiêu tốn (dùng để đo lường chi phí API)

  // 3. Timestamps
  timestamp  DateTime @default(now()) @db.Timestamptz // Thời điểm phát sinh câu hỏi/câu trả lời
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo bản ghi

  // Relations
  user   User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  course Course? @relation(fields: [course_id], references: [course_id], onDelete: SetNull)

  @@index([user_id, timestamp(sort: Desc)], map: "idx_ai_conversations_user")
  @@map("ai_conversations")
}

// ================================================================
// MODULE 9: QUIZ (Bài kiểm tra trắc nghiệm & Tự luận)
// ================================================================

// Phân loại kiểu câu hỏi trong đề kiểm tra
enum QuizQuestionType {
  multiple_choice // Trắc nghiệm chọn 1 đáp án đúng từ các phương án (A, B, C, D)
  true_false // Độc lập dạng Chọn Đúng / Sai
  fill_in_blank // Điền câu trả lời ngắn vào chỗ trống
  essay // Tự luận (cần giáo viên hoặc AI chấm điểm chi tiết)
}

// Trạng thái của bài kiểm tra
enum QuizStatus {
  draft // Bản nháp: Gia sư hoặc AI đang tạo đề, học sinh chưa nhìn thấy
  published // Đã phát hành: Học sinh có thể vào làm bài kiểm tra
  archived // Lưu trữ: Đã đóng, dùng để lưu lịch sử làm bài
}

// ================================================================
// BẢNG: quizzes
// Mô tả: Quản lý danh mục bài kiểm tra / đề thi gắn với từng Khóa học.
// Điểm nổi bật: Hỗ trợ tính năng AI tự động sinh đề thi từ tài liệu (generated_by_ai = true).
// ================================================================
model Quiz {
  // 1. Primary Key & Foreign Keys
  quiz_id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bài quiz
  course_id String @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa các bài quiz)

  // 2. Quiz Metadata & Rules
  title              String // Tiêu đề bài kiểm tra (VD: "Kiểm tra 15 phút - Đạo hàm & Tiệm cận")
  description        String? // Mô tả hướng dẫn hoặc lưu ý khi học sinh làm bài
  time_limit_minutes Int? // Thời gian giới hạn làm bài tính bằng phút (null = làm tự do không giới hạn thời gian)
  max_attempts       Int        @default(1) // Số lần làm bài tối đa của 1 học sinh (mặc định 1 lần)
  passing_score      Int?       @db.SmallInt // Điểm tối thiểu để được tính là Đạt / Qua bài thi (VD: 5/10)
  status             QuizStatus @default(draft) // Trạng thái bài kiểm tra (draft -> published -> archived)

  // 3. AI Generation Config
  generated_by_ai  Boolean @default(false) // Cờ đánh dấu đề thi do AI tự động khởi tạo từ tài liệu học tập
  ai_model_version String? // Phiên bản mô hình AI sinh đề (VD: "gpt-4o", "gemini-1.5-flash")

  // 4. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo bài quiz

  // Relations
  course    Course         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([course_id, status], map: "idx_quizzes_course")
  @@map("quizzes")
}

// ================================================================
// BẢNG: quiz_questions
// Mô tả: Lưu trữ danh sách các câu hỏi trong đề thi.
// Thiết kế: Sử dụng options_json lưu mảng các phương án trắc nghiệm giúp render UI cực kỳ linh hoạt.
// ================================================================
model QuizQuestion {
  // 1. Primary Key & Foreign Keys
  question_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho câu hỏi
  quiz_id     String @db.Uuid // Khóa ngoại liên kết tới quizzes.quiz_id (Xóa bài quiz -> xóa các câu hỏi)

  // 2. Question Details
  question_text String // Nội dung văn bản câu hỏi
  question_type QuizQuestionType @default(multiple_choice) // Phân loại kiểu câu hỏi (multiple_choice, true_false...)
  explanation   String? // Lời giải chi tiết / Hướng dẫn phương pháp giải giúp học sinh ôn luyện
  points        Int              @default(1) @db.SmallInt // Điểm số tương ứng với câu hỏi (mặc định = 1)
  order_index   Int              @default(0) // Thứ tự hiển thị của câu hỏi trong đề thi (0, 1, 2...)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo câu hỏi

  // Relations
  quiz    Quiz         @relation(fields: [quiz_id], references: [quiz_id], onDelete: Cascade)
  options QuizOption[]

  @@index([quiz_id, order_index], map: "idx_quiz_questions_quiz")
  @@map("quiz_questions")
}

// ================================================================
// BẢNG: quiz_options
// Mô tả: Lưu trữ các phương án lựa chọn trắc nghiệm cho từng câu hỏi.
// Thiết kế: Chuẩn hóa 3NF tách riêng khỏi QuizQuestion giúp chấm điểm chính xác và chống lệch dữ liệu.
// ================================================================
model QuizOption {
  // 1. Primary Key & Foreign Keys
  option_id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho lựa chọn đáp án
  question_id String @db.Uuid // Khóa ngoại liên kết tới quiz_questions.question_id (Xóa câu hỏi -> xóa các lựa chọn)

  // 2. Option Details
  content     String // Nội dung phương án lựa chọn (VD: "Đáp án A: 12", "Hà Nội")
  is_correct  Boolean @default(false) // Đánh dấu đây có phải đáp án đúng hay không (true = đúng)
  order_index Int     @default(0) // Thứ tự hiển thị của phương án trong câu hỏi (0, 1, 2...)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo phương án

  // Relations
  question QuizQuestion @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@index([question_id, order_index], map: "idx_quiz_options_question")
  @@map("quiz_options")
}

// ================================================================
// BẢNG: quiz_attempts
// Mô tả: Lưu trữ kết quả thực tế từng lần học sinh tham gia làm bài thi.
// Luồng: Học sinh bấm làm -> Lưu started_at -> Học sinh nộp bài -> Tự động tính score, duration_seconds, is_passed.
// ================================================================
model QuizAttempt {
  // 1. Primary Key & Foreign Keys
  attempt_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho lượt làm bài
  student_id String @db.Uuid // Khóa ngoại liên kết tới student_profiles.student_id (học sinh tham gia làm bài)
  quiz_id    String @db.Uuid // Khóa ngoại liên kết tới quizzes.quiz_id (bài quiz được thực hiện)

  // 2. Score & Response Data
  score            Decimal? @db.Decimal(5, 2) // Điểm số học sinh đạt được (VD: 8.50)
  total_points     Int? // Tổng điểm tối đa của đề thi tại thời điểm làm bài
  answers_json     Json?    @default("[]") // Mảng JSON lưu trữ danh sách các câu trả lời học sinh đã nộp
  duration_seconds Int? // Thời gian thực tế học sinh làm bài (tính bằng giây)
  is_passed        Boolean? // Cờ đánh dấu học sinh có Đạt hay không (score >= passing_score)

  // 3. Timestamps
  started_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm bắt đầu làm bài
  completed_at DateTime? @db.Timestamptz // Thời điểm học sinh hoàn thành và nộp bài
  created_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm lưu lượt làm bài

  // Relations
  student StudentProfile @relation(fields: [student_id], references: [student_id])
  quiz    Quiz           @relation(fields: [quiz_id], references: [quiz_id])

  @@index([student_id, created_at(sort: Desc)], map: "idx_quiz_attempts_student")
  @@index([quiz_id], map: "idx_quiz_attempts_quiz")
  @@map("quiz_attempts")
}

// ================================================================
// MODULE 10: ADMIN & SYSTEM (Quản trị hệ thống & Bảng vẽ)
// ================================================================

// ================================================================
// BẢNG: admin_logs
// Mô tả: Nhật ký ghi vết mọi hành động quản trị của Admin (Audit Log / Audit Trail).
// Mục đích: Phục vụ bảo mật, truy vết sự cố, kiểm tra quyền hạn và đảm bảo tính minh bạch hệ thống.
// ================================================================
model AdminLog {
  // 1. Primary Key & Foreign Keys
  log_id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bản ghi audit log
  admin_id  String  @db.Uuid // Khóa ngoại liên kết tới users.user_id (tài khoản Admin thực hiện thao tác)
  target_id String? @db.Uuid // Mã ID định danh của đối tượng chịu tác động

  // 2. Log Action & Target Details
  action       String // Tên hành động quản trị (VD: "APPROVE_TUTOR", "SUSPEND_USER", "REFUND_BOOKING")
  target_type  String // Phân loại đối tượng chịu tác động (VD: "USER", "TUTOR_PROFILE", "BOOKING", "PAYOUT")
  details_json Json? // Mảng JSON ghi nhận chi tiết dữ liệu trước và sau khi Admin thay đổi
  ip_address   String? // Địa chỉ IP của Admin tại thời điểm gửi yêu cầu thao tác

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm thực hiện hành động quản trị

  // Relations
  admin User @relation(fields: [admin_id], references: [user_id])

  @@index([admin_id, created_at(sort: Desc)], map: "idx_admin_logs_admin")
  @@index([target_type, target_id], map: "idx_admin_logs_target")
  @@map("admin_logs")
}

// ================================================================
// BẢNG: system_configs
// Mô tả: Lưu trữ các tham số cấu hình động toàn hệ thống dưới dạng cặp Khóa - Giá trị (Key-Value).
// Ưu điểm: Cho phép Admin thay đổi tham số kinh doanh (tỷ lệ hoa hồng, kích thước file...) mà không cần sửa code/re-deploy.
// ================================================================
model SystemConfig {
  // 1. Primary Key
  config_key String @id // Khóa chính đại diện tên cấu hình (VD: "COMMISSION_RATE", "MAX_FILE_SIZE_MB", "MAINTENANCE_MODE")

  // 2. Value & Description
  config_value String? // Giá trị cấu hình tương ứng dưới dạng chuỗi (VD: "15.0", "50", "false")
  description  String? // Mô tả ý nghĩa và mục đích sử dụng của tham số cấu hình này

  // 3. Timestamps
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật giá trị cấu hình mới nhất

  @@map("system_configs")
}

// ================================================================
// MODULE 11: ARTICLE & COMMENT (Bài viết & Bình luận)
// ================================================================

// ================================================================
// BẢNG: article_categories
// Mô tả: Danh mục bài viết do Admin quản lý (thêm/sửa/xóa).
// ================================================================
model ArticleCategory {
  // 1. Primary Key
  category_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // 2. Category Details
  name        String  @unique // Tên danh mục (VD: "Bí quyết ôn thi", "Tin tức giáo dục")
  slug        String  @unique // Đường dẫn thân thiện SEO (VD: "bi-quyet-on-thi")
  description String? // Mô tả ngắn gọn về danh mục
  order_index Int     @default(0) // Thứ tự hiển thị
  is_active   Boolean @default(true) // Trạng thái kích hoạt

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz

  articles Article[]

  @@map("article_categories")
}

// ================================================================
// BẢNG: articles
// Mô tả: Quản lý các bài viết tin tức, bí quyết ôn thi, kinh nghiệm học tập và thông báo hệ thống.
// Thiết kế: Sử dụng kiểu dữ liệu Json cho content để lưu trữ nội dung Rich Text Block dạng EditorJS.
// ================================================================
model Article {
  // 1. Primary Key & Foreign Keys
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bài viết
  author_id   String? @db.Uuid // Khóa ngoại liên kết tới users.user_id (Gia sư/Admin đăng bài)
  category_id String? @db.Uuid // Khóa ngoại liên kết tới article_categories.category_id

  // 2. Article Content Details
  title         String // Tiêu đề bài viết (VD: "Bí quyết đạt 8.0 IELTS trong 6 tháng")
  slug          String? @unique // Đường dẫn chuẩn SEO (VD: "bi-quyet-dat-8-0-ielts")
  excerpt       String // Đoạn trích dẫn ngắn / Tóm tắt nội dung bài viết
  content       Json // Nội dung chi tiết bài viết dưới dạng mảng JSON Rich Text Blocks
  thumbnail_url String? // Đường dẫn URL ảnh đại diện bài viết
  tags          Json // Mảng JSON chứa các từ khóa thẻ tag
  imageType     String? // Giữ lại trường cũ tránh mất dữ liệu
  author        String? // Giữ lại tên tác giả chuỗi cũ
  category      String? // Giữ lại tên danh mục chuỗi cũ

  // 3. Counters & Flags
  commentsCount Int     @default(0) // Tổng số lượng bình luận
  view_count    Int     @default(0) // Số lượt người đọc bài viết
  is_published  Boolean @default(false) // Trạng thái xuất bản bài viết

  // 4. Timestamps
  published_at DateTime? @db.Timestamptz // Thời điểm xuất bản bài viết
  created_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm tạo bài viết
  updated_at   DateTime  @default(now()) @db.Timestamptz // Thời điểm cập nhật bài viết gần nhất

  // Relations
  author_user       User?            @relation(fields: [author_id], references: [user_id], onDelete: SetNull)
  category_relation ArticleCategory? @relation(fields: [category_id], references: [category_id], onDelete: SetNull)
  comments          ArticleComment[]

  @@index([author_id], map: "idx_articles_author")
  @@index([category_id, published_at(sort: Desc)], map: "idx_articles_category")
  @@index([published_at(sort: Desc)], map: "idx_articles_published")
  @@map("articles")
}

// ================================================================
// BẢNG: article_comments
// Mô tả: Lưu trữ các bình luận trao đổi của học sinh/gia sư bên dưới mỗi bài viết blog/tin tức.
// Quan hệ: N-1 với articles (article_id) và users (user_id).
// ================================================================
model ArticleComment {
  // 1. Primary Key & Foreign Keys
  comment_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bình luận bài viết
  article_id String @db.Uuid // Khóa ngoại liên kết tới articles.id (Xóa bài viết -> xóa các bình luận)
  user_id    String @db.Uuid // Khóa ngoại liên kết tới users.user_id (người viết bình luận)

  // 2. Comment Content & Visibility
  content    String // Nội dung văn bản bình luận
  is_visible Boolean @default(true) // Trạng thái hiển thị (true = công khai, false = ẩn do vi phạm)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm gửi bình luận
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm chỉnh sửa bình luận

  // Relations
  article Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([article_id, created_at(sort: Desc)], map: "idx_article_comments_article")
  @@index([user_id], map: "idx_article_comments_user")
  @@map("article_comments")
}

// ================================================================
// BẢNG: course_comments
// Mô tả: Lưu trữ các bình luận hỏi đáp, thắc mắc công khai của người dùng trên trang chi tiết Khóa học.
// Phân biệt: Khác với Review (Module 7 - chỉ viết sau khi học xong), CourseComment dành cho thảo luận trước khi mua.
// ================================================================
model CourseComment {
  // 1. Primary Key & Foreign Keys
  comment_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Khóa chính UUID cho bình luận khóa học
  course_id  String @db.Uuid // Khóa ngoại liên kết tới courses.course_id (Xóa khóa học -> xóa bình luận)
  user_id    String @db.Uuid // Khóa ngoại liên kết tới users.user_id (người đăng thắc mắc/bình luận)

  // 2. Comment Content & Rating
  content    String // Nội dung văn bản thắc mắc hoặc thảo luận
  rating     Int?    @db.SmallInt // Điểm số đánh giá tùy chọn (giữ lại hỗ trợ dữ liệu cũ)
  is_visible Boolean @default(true) // Trạng thái hiển thị (true = công khai, false = ẩn do vi phạm)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz // Thời điểm tạo bình luận
  updated_at DateTime @default(now()) @db.Timestamptz // Thời điểm cập nhật bình luận

  // Relations
  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([course_id, created_at(sort: Desc)], map: "idx_course_comments_course")
  @@index([user_id], map: "idx_course_comments_user")
  @@map("course_comments")
}

// ================================================================
// MODULE 12: GIA SƯ OFFLINE & BẢNG GIÁ THAM KHẢO
// ================================================================

enum ClassRequestStatus {
  PENDING_ADMIN // Mới tạo, chờ Admin kiểm tra và duyệt mở lớp
  WAITING_PAYMENT // Gia sư đã được chọn (ClassApplication APPROVED), đang chờ Học viên đóng học phí VÀ Gia sư đóng phí nhận lớp (xem OfflineClassPayment). Khi cả 2 đã PAID -> hệ thống tạo OfflineClass và xóa record này
  OPEN // Lớp chưa giao / Đang cần gia sư (Hiển thị danh sách công khai). Cũng là trạng thái được MỞ LẠI khi Gia sư trễ hạn thanh toán (lỗi thuộc về Gia sư -> hoàn tiền Học viên đã đóng nếu có, request vẫn còn giá trị nên quay lại OPEN cho Gia sư khác ứng tuyển)
  REJECTED // Admin từ chối yêu cầu
  CANCELLED // Học viên hủy yêu cầu
  EXPIRED // Học viên trễ hạn thanh toán (lỗi thuộc về Học viên) -> hoàn tiền Gia sư đã đóng nếu có, request đóng vĩnh viễn (không mở lại vì bên khởi tạo request đã không hoàn tất nghĩa vụ)
}

enum ClassApplicationStatus {
  PENDING // Đã gửi đơn ứng tuyển nhanh, chờ Admin duyệt
  APPROVED // Được Admin chọn và giao lớp
  APPROVED_WAITING_FEE // Được duyệt, đang chờ gia sư thanh toán phí (legacy)
  REJECTED // Bị Admin chủ động từ chối
  EXPIRED // Đã được duyệt (APPROVED) nhưng Gia sư không thanh toán phí nhận lớp kịp hạn -> tự động bỏ lỡ lớp (khác REJECTED vì đây là do Gia sư không hành động, không phải Admin từ chối)
}

enum OfflineClassStatus {
  ACTIVE // Lớp đang hoạt động (chỉ được tạo ra khi cả Học viên và Gia sư đã đóng tiền giữ chỗ đầy đủ - xem OfflineClassPayment)
  CANCELLED // Lớp bị hủy do phát sinh sự cố trong 7 ngày đầu (xử lý qua RefundTicket)
}

// Loại khoản tiền giữ chỗ (escrow) bắt buộc phải đóng trước khi lớp được giao (tạo OfflineClass)
enum EscrowPaymentType {
  STUDENT_TUITION // Học phí tháng đầu tiên do Học viên đóng (100% class_salary)
  TUTOR_PLACEMENT_FEE // Phí nhận lớp do Gia sư đóng (= class_salary * commission_rate%)
}

// Trạng thái của từng khoản tiền giữ chỗ (escrow) trong OfflineClassPayment
enum EscrowPaymentStatus {
  PENDING // Chưa đóng tiền (đang ở giai đoạn ClassRequest, chờ thanh toán)
  PAID // Đã đóng đủ, tiền đang được hệ thống tạm giữ (escrow)
  REFUNDED // Đã hoàn trả 100% tiền đã đóng (bên KHÔNG có lỗi khi hủy lớp trong 7 ngày, HOẶC khi bên còn lại trễ hạn thanh toán ở vòng WAITING_PAYMENT)
  PARTIALLY_REFUNDED // Đã hoàn trả một phần sau khi trừ tiền phạt (90% hoặc 80% tùy trường hợp lỗi)
  EXPIRED // Còn PENDING (chưa từng đóng tiền) nhưng ClassRequest đã quay vòng/đóng lại nên nghĩa vụ này hết hiệu lực - không có dòng tiền phát sinh, giữ lại chỉ để audit
}

// Bên bị xác định là có lỗi dẫn tới việc hủy lớp trong vòng 7 ngày đầu kể từ khi giao lớp
enum RefundFaultType {
  STUDENT_FAULT // Lỗi do Học viên (VD: tự ý hủy, cung cấp thông tin sai sự thật...)
  TUTOR_FAULT // Lỗi do Gia sư (VD: không đến dạy, vi phạm cam kết...)
}

// Trạng thái xử lý của yêu cầu hủy/hoàn tiền (RefundTicket)
enum RefundTicketStatus {
  PENDING // Học viên hoặc Gia sư vừa gửi yêu cầu hủy, đang chờ Admin xử lý
  APPROVED // Admin đã xác nhận bên có lỗi (fault_type) và chốt số tiền hoàn/phạt, chờ thực hiện chuyển tiền
  REJECTED // Admin từ chối yêu cầu hủy (không đủ căn cứ)
  COMPLETED // Đã hoàn tất chuyển tiền hoàn trả và ghi nhận tiền phạt, lớp chuyển sang CANCELLED
}

// ================================================================
// BẢNG: class_requests
// Mô tả: Quản lý các đơn đăng ký / bài đăng tìm gia sư dạy kèm Offline của Phụ huynh / Học viên.
// Luồng: Học viên tạo bài (PENDING_ADMIN/WAITING_TUTOR_CONFIRM) -> Admin duyệt mở lớp (OPEN) -> Gia sư ứng tuyển -> Admin duyệt & gia sư đóng phí -> Chuyển sang bảng offline_classes (đồng thời XÓA record trong class_requests này).
// Tương tự: "Giỏ hàng" chờ thanh toán.
// ================================================================
model ClassRequest {
  // 1. Primary Key & Foreign Keys
  request_id  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id  String?     @db.Uuid // FK tới student_profiles.student_id (nếu học viên đăng nhập)
  grade_level GradeLevel? // Khối lớp học (Lớp 1 - 12)
  subject_id  String?     @db.Uuid // FK tới subjects.subject_id

  // 2. Code & Student Info
  class_code     String? @unique // Mã lớp học hiển thị (VD: MS: 89513)
  student_name   String // Họ tên học viên / phụ huynh
  phone          String // Số điện thoại liên hệ
  email          String? // Email liên hệ
  address_detail String // Địa chỉ chi tiết (VD: tỉnh lộ 43 - Bình Chiểu)
  district       String? // Quận / Huyện (VD: Q.Thủ Đức)
  province       String? // Tỉnh / Thành phố (VD: Hồ Chí Minh)

  // 3. Request Requirements & Pricing
  num_students        Int     @default(1) // Số lượng học sinh
  academic_level      String? // Học lực hiện tại / Thông tin học sinh (VD: Nam, học giỏi)
  sessions_per_week   Int     @default(2) // Số buổi (VD: 2 buổi/tuần)
  study_time          String? // Thời gian học (VD: Dạy 120 phút/buổi, các tối 18h-20h)
  tutor_requirement   String? // Yêu cầu gia sư (VD: Nữ Sinh Viên, Giáo Viên)
  selected_tutor_code String? // Mã số/tên gia sư học viên điền thủ công (VD: 7650, 2907)
  class_salary        Decimal @default(0) @db.Decimal(12, 2) // Tiền chi cho lớp học (VNĐ/tháng)
  other_requirements  String? // Yêu cầu khác

  // 4. Status & Administrative Notes
  status           ClassRequestStatus @default(PENDING_ADMIN)
  payment_deadline DateTime?          @db.Timestamptz // Hạn chót đóng đủ 2 khoản escrow kể từ khi chuyển WAITING_PAYMENT; NULL nếu chưa vào giai đoạn này. Đọc bởi cron job tự động xử lý trễ hạn (xem src/jobs/escrowExpiration.job.ts)
  admin_note       String? // Lý do từ chối hoặc ghi chú quản trị của Admin

  // 5. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  // Relations
  student      StudentProfile?       @relation(fields: [student_id], references: [student_id], onDelete: SetNull)
  subject      Subject?              @relation(fields: [subject_id], references: [subject_id], onDelete: SetNull)
  applications ClassApplication[]
  payments     OfflineClassPayment[] // Các khoản tiền giữ chỗ (học phí học viên / phí nhận lớp gia sư) đang chờ thanh toán ở giai đoạn "giỏ hàng" này

  @@index([status, created_at(sort: Desc)], map: "idx_class_requests_status")
  @@index([status, payment_deadline], map: "idx_class_requests_payment_deadline")
  @@index([province, district], map: "idx_class_requests_location")
  @@map("class_requests")
}

// ================================================================
// BẢNG: offline_classes
// Mô tả: Quản lý danh sách các Lớp học Offline đã chính thức giao cho Gia sư.
//        Được tạo ra khi Gia sư thanh toán phí nhận lớp thành công.
//        Đồng thời ClassRequest tương ứng sẽ bị XÓA (tương tự chuyển từ Giỏ hàng sang Đơn hàng).
// ================================================================
model OfflineClass {
  // 1. Primary Key & Foreign Keys
  class_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutor_id   String  @db.Uuid // FK → tutor_profiles.tutor_id (gia sư nhận lớp)
  student_id String? @db.Uuid // FK → student_profiles.student_id (nếu học viên đăng nhập)

  // 2. Snapshot thông tin lớp học (copy từ ClassRequest tại thời điểm giao)
  class_offline_code String? // Mã lớp gốc (copy từ ClassRequest.class_code)
  student_name       String // Họ tên học viên / phụ huynh
  phone              String // Số điện thoại liên hệ
  email              String? // Email liên hệ
  address_detail     String // Địa chỉ chi tiết
  district           String? // Quận / Huyện
  province           String? // Tỉnh / Thành phố
  grade_level        GradeLevel? // Khối lớp (Lớp 1 - 12)
  num_students       Int         @default(1) // Số lượng học sinh
  academic_level     String? // Học lực học sinh
  sessions_per_week  Int         @default(2) // Số buổi / tuần
  study_time         String? // Thời gian học

  // 3. Thông tin tài chính khi giao lớp
  // (Không còn fee_amount/paid_at riêng lẻ - toàn bộ lịch sử đóng tiền của cả Học viên lẫn Gia sư
  //  được chuyển sang lưu ở bảng OfflineClassPayment để hỗ trợ audit và tính hoàn tiền/phạt)
  class_salary    Decimal @db.Decimal(12, 2) // Tiền chi cho lớp học (VNĐ/tháng) - cũng là cơ sở tính học phí escrow (STUDENT_TUITION)
  commission_rate Decimal @default(35) @db.Decimal(5, 2) // Phí nhận lớp (%) - cũng là cơ sở tính phí escrow của gia sư (TUTOR_PLACEMENT_FEE)

  // 4. Trạng thái & Ghi chú
  status     OfflineClassStatus @default(ACTIVE) // Record chỉ được tạo ra khi cả 2 bên đã đóng tiền giữ chỗ xong nên mặc định luôn là ACTIVE
  admin_note String? // Ghi chú quản trị của Admin

  // 5. Timestamps
  assigned_at     DateTime @default(now()) @db.Timestamptz // Thời điểm giao lớp = thời điểm cả 2 bên đã thanh toán xong (đồng thời là mốc bắt đầu tính hạn hoàn tiền 7 ngày)
  refund_deadline DateTime @default(dbgenerated("(now() + interval '7 days')")) @db.Timestamptz // Hạn chót được quyền gửi yêu cầu hủy/hoàn tiền = assigned_at + 7 ngày, lưu sẵn để truy vấn nhanh các lớp còn trong hạn hoàn tiền
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz

  // Relations
  tutor          TutorProfile          @relation(fields: [tutor_id], references: [tutor_id])
  student        StudentProfile?       @relation(fields: [student_id], references: [student_id])
  payments       OfflineClassPayment[] // Lịch sử 2 khoản tiền giữ chỗ (học phí học viên + phí nhận lớp gia sư) đã đóng cho lớp này
  refund_tickets RefundTicket[] // Các yêu cầu hủy/hoàn tiền phát sinh trong 7 ngày đầu của lớp này

  @@index([tutor_id, status], map: "idx_offline_classes_tutor")
  @@index([status, assigned_at(sort: Desc)], map: "idx_offline_classes_status")
  @@index([province, district], map: "idx_offline_classes_location")
  @@map("offline_classes")
}

// ================================================================
// BẢNG: class_applications
// Mô tả: Quản lý danh sách các Gia sư ứng tuyển / Đăng ký nhận lớp học Offline.
// ================================================================
model ClassApplication {
  // 1. Primary Key & Foreign Keys
  application_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_request_id String  @db.Uuid
  tutor_id         String? @db.Uuid // FK tùy chọn tới tutor_profiles.tutor_id

  // 2. Application Details & Status
  applicant_phone String // Số điện thoại người đăng ký nhận lớp
  notes           String? // Yêu cầu thêm / Ghi chú
  status          ClassApplicationStatus @default(PENDING)

  // 3. Timestamps
  available_from DateTime? @db.Date // Ngày có thể bắt đầu nhận lớp sớm nhất
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @default(now()) @db.Timestamptz

  // Relations
  class_request ClassRequest  @relation(fields: [class_request_id], references: [request_id], onDelete: Cascade)
  tutor         TutorProfile? @relation(fields: [tutor_id], references: [tutor_id], onDelete: SetNull)

  @@index([class_request_id], map: "idx_class_applications_request")
  @@index([tutor_id], map: "idx_class_applications_tutor")
  @@map("class_applications")
}

// ================================================================
// BẢNG: offline_class_payments
// Mô tả: Sổ cái (ledger) từng khoản tiền giữ chỗ (escrow) bắt buộc của Học viên (học phí tháng đầu)
//        và Gia sư (phí nhận lớp). Một ClassRequest có thể có NHIỀU dòng cùng loại theo thời gian nếu
//        quay vòng qua nhiều lượt WAITING_PAYMENT (VD: gia sư A trễ hạn -> dòng TUTOR_PLACEMENT_FEE của
//        A chuyển EXPIRED, request mở lại OPEN, gia sư B ứng tuyển -> tạo dòng TUTOR_PLACEMENT_FEE mới).
// Luồng: Tạo ra ngay khi ClassApplication được APPROVED (class_request_id được gán, class_id còn NULL,
//        status = PENDING) -> mỗi bên thanh toán -> status = PAID.
//        - Nếu CẢ HAI đều PAID: hệ thống tạo OfflineClass, gán class_id cho 2 dòng vừa PAID rồi mới XÓA
//          ClassRequest (class_request_id tự động về NULL nhờ onDelete: SetNull, không mất lịch sử).
//        - Nếu MỘT bên trễ hạn thanh toán: dòng PENDING của bên trễ hạn -> EXPIRED (không có tiền phát
//          sinh); dòng PAID của bên còn lại (nếu có) -> REFUNDED (hệ thống hoàn lại); ClassRequest quay
//          về OPEN (nếu lỗi thuộc Gia sư) hoặc đóng hẳn EXPIRED (nếu lỗi thuộc Học viên).
//        Nếu về sau lớp đã ACTIVE bị hủy trong 7 ngày (RefundTicket), 2 dòng đã gán class_id được cập
//        nhật tiếp sang REFUNDED/PARTIALLY_REFUNDED để phản ánh số tiền hoàn/phạt cuối cùng.
// ================================================================
model OfflineClassPayment {
  // 1. Primary Key & Foreign Keys
  payment_id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_request_id String? @db.Uuid // FK -> class_requests.request_id: chỉ có giá trị khi lớp còn ở giai đoạn "giỏ hàng", tự động NULL khi ClassRequest bị xóa lúc chuyển đổi
  class_id         String? @db.Uuid // FK -> offline_classes.class_id: chỉ được gán giá trị sau khi CẢ HAI bên đã thanh toán xong và lớp được giao (tạo OfflineClass)
  payer_user_id    String  @db.Uuid // FK -> users.user_id: người có nghĩa vụ đóng khoản tiền này (tài khoản Học viên hoặc Gia sư)
  transaction_id   String? @unique @db.Uuid // FK -> transactions.transaction_id: giao dịch thanh toán gốc đã thành công (tái sử dụng cổng thanh toán ZaloPay/Wallet có sẵn)

  // 2. Loại tiền, Trạng thái & Số tiền
  type            EscrowPaymentType // STUDENT_TUITION (học viên) hoặc TUTOR_PLACEMENT_FEE (gia sư)
  status          EscrowPaymentStatus @default(PENDING) // PENDING -> PAID -> REFUNDED / PARTIALLY_REFUNDED
  required_amount Decimal             @db.Decimal(12, 2) // Số tiền bắt buộc phải đóng, snapshot tại thời điểm tạo (= class_salary hoặc class_salary * commission_rate%)
  paid_amount     Decimal?            @db.Decimal(12, 2) // Số tiền thực tế đã đóng (đối soát với required_amount)
  penalty_amount  Decimal?            @default(0) @db.Decimal(12, 2) // Số tiền bị phạt giữ lại khi hủy lớp do lỗi của chính bên này (0 nếu không có lỗi)
  refunded_amount Decimal?            @db.Decimal(12, 2) // Số tiền thực tế đã hoàn trả lại cho người đóng (= paid_amount - penalty_amount)

  // 3. Timestamps
  paid_at     DateTime? @db.Timestamptz // Thời điểm thanh toán thành công
  refunded_at DateTime? @db.Timestamptz // Thời điểm hoàn tiền được xử lý xong
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @default(now()) @db.Timestamptz

  // Relations
  class_request ClassRequest? @relation(fields: [class_request_id], references: [request_id], onDelete: SetNull)
  offline_class OfflineClass? @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  payer         User          @relation(fields: [payer_user_id], references: [user_id])
  transaction   Transaction?  @relation(fields: [transaction_id], references: [transaction_id], onDelete: SetNull)

  // Lưu ý: KHÔNG đặt unique([class_request_id, type]) vì 1 ClassRequest có thể quay vòng qua nhiều lượt
  // WAITING_PAYMENT (mỗi lượt gia sư trễ hạn sẽ tạo ra 1 dòng TUTOR_PLACEMENT_FEE mới cho gia sư kế tiếp,
  // các dòng cũ giữ nguyên với status EXPIRED/REFUNDED để audit) -> chỉ đánh index thường để tra cứu.
  @@unique([class_id, type], map: "uq_offline_class_payments_class_type") // Mỗi OfflineClass (đã giao lớp) chỉ có đúng 1 dòng học phí + 1 dòng phí nhận lớp
  @@index([class_request_id, type], map: "idx_offline_class_payments_request_type")
  @@index([status], map: "idx_offline_class_payments_status")
  @@index([payer_user_id], map: "idx_offline_class_payments_payer")
  @@map("offline_class_payments")
}

// ================================================================
// BẢNG: refund_tickets
// Mô tả: Yêu cầu hủy lớp & hoàn tiền, chỉ áp dụng trong vòng 7 ngày kể từ OfflineClass.assigned_at
//        (đối chiếu với OfflineClass.refund_deadline khi xử lý ở tầng application).
// Luồng: Học viên/Gia sư tạo ticket (PENDING) -> Admin xác định fault_type và tính toán số tiền
//        hoàn/phạt theo đúng quy tắc kinh doanh (10%/90% nếu lỗi Học viên, 20%/80% nếu lỗi Gia sư)
//        -> APPROVED hoặc REJECTED -> nếu APPROVED thì thực hiện chuyển tiền xong -> COMPLETED,
//        đồng thời đồng bộ ngược trạng thái 2 dòng OfflineClassPayment và chuyển OfflineClass sang CANCELLED.
// ================================================================
model RefundTicket {
  // 1. Primary Key & Foreign Keys
  ticket_id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_id     String  @db.Uuid // FK -> offline_classes.class_id
  requested_by String  @db.Uuid // FK -> users.user_id: người gửi yêu cầu hủy (tài khoản Học viên hoặc Gia sư)
  processed_by String? @db.Uuid // FK -> users.user_id: Admin đã duyệt/từ chối yêu cầu này

  // 2. Nội dung yêu cầu & Kết luận xử lý
  reason     String // Lý do hủy do người gửi yêu cầu tường trình
  fault_type RefundFaultType? // Bên bị xác định có lỗi - Admin điền khi xử lý (NULL khi còn PENDING)
  admin_note String? // Ghi chú / căn cứ kết luận của Admin
  status     RefundTicketStatus @default(PENDING)

  // 3. Số tiền phía Học viên (snapshot tại thời điểm xử lý, tính từ OfflineClassPayment loại STUDENT_TUITION)
  student_tuition_amount Decimal @db.Decimal(12, 2) // Số tiền học phí tháng đầu học viên đã đóng
  student_penalty_amount Decimal @default(0) @db.Decimal(12, 2) // Số tiền học viên bị phạt giữ lại (10% nếu STUDENT_FAULT, ngược lại 0)
  student_refund_amount  Decimal @default(0) @db.Decimal(12, 2) // Số tiền hệ thống hoàn lại cho học viên (90% nếu STUDENT_FAULT, 100% nếu TUTOR_FAULT)

  // 4. Số tiền phía Gia sư (snapshot tại thời điểm xử lý, tính từ OfflineClassPayment loại TUTOR_PLACEMENT_FEE)
  tutor_fee_amount     Decimal @db.Decimal(12, 2) // Số tiền phí nhận lớp gia sư đã đóng
  tutor_penalty_amount Decimal @default(0) @db.Decimal(12, 2) // Số tiền gia sư bị phạt giữ lại (20% nếu TUTOR_FAULT, ngược lại 0)
  tutor_refund_amount  Decimal @default(0) @db.Decimal(12, 2) // Số tiền hệ thống hoàn lại cho gia sư (80% nếu TUTOR_FAULT, 100% nếu STUDENT_FAULT)

  // 5. Timestamps
  requested_at DateTime  @default(now()) @db.Timestamptz // Thời điểm gửi yêu cầu hủy (phải <= OfflineClass.refund_deadline mới hợp lệ)
  processed_at DateTime? @db.Timestamptz // Thời điểm Admin xử lý xong (APPROVED/REJECTED)
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @default(now()) @db.Timestamptz

  // Relations
  offline_class   OfflineClass @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  requester       User         @relation("RefundTicketRequester", fields: [requested_by], references: [user_id])
  processed_admin User?        @relation("RefundTicketProcessor", fields: [processed_by], references: [user_id], onDelete: SetNull)

  @@index([class_id], map: "idx_refund_tickets_class")
  @@index([status, requested_at(sort: Desc)], map: "idx_refund_tickets_status")
  @@map("refund_tickets")
}

// ================================================================
// BẢNG: reference_prices
// Mô tả: Bảng giá tham khảo lương gia sư theo khối lớp và số buổi/tuần.
//        Dùng min/max Decimal thay vì String "600 - 700" để so sánh/filter chính xác.
// ================================================================
model ReferencePrice {
  // 1. Primary Key
  price_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // 2. Reference Pricing Parameters
  grade_group         String // LỚP 1, 2, 3, 4 | LỚP 5, 6, 7, 8 | LỚP 9, 10, 11, 12 | LTDH - NGOẠI NGỮ
  sessions_per_week   Int // 2, 3, 4, 5
  student_tutor_price String // e.g. "600 - 700" (k/tháng)
  teacher_tutor_price String // e.g. "1100 - 1300" (k/tháng)

  // 3. Timestamps
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  @@map("reference_prices")
}
